@{
    ViewData["Title"] = "Quản lý giao hàng & Vận chuyển";
    ViewData["ActiveNav"] = "delivery";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/delivery.css" asp-append-version="true" />
}

<!-- =======================================================================
     COLUMN 2: CENTRAL WORKSPACE (WARM CREAM BACKGROUND)
     ======================================================================= -->
<main class="center-workspace">
  <!-- Title & Headline -->
  <div class="workspace-top-bar">
    <div class="page-heading-group">
      <h1>QUẢN LÝ GIAO HÀNG &amp; VẬN CHUYỂN</h1>
      <p>Theo dõi trạng thái giao vận Lalamove, kiểm tra địa giới giao hàng và chính sách trợ giá cước vận chuyển</p>
    </div>
    <div style="display: flex; gap: 8px;">
      <button type="button" class="btn-refresh-delivery" id="btnRefreshDelivery" onclick="loadDeliveryData()" title="Làm mới dữ liệu từ máy chủ">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
          <path d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
        </svg>
        <span>Làm mới dữ liệu</span>
      </button>
    </div>
  </div>

  <!-- Scope Notice Banner: Ho Chi Minh City Policy -->
  <div class="hcm-scope-banner">
    <svg viewBox="0 0 24 24">
      <path d="M12 2C8.13 2 5 5.13 5 9C5 14.25 12 22 12 22C12 22 19 14.25 19 9C19 5.13 15.87 2 12 2M12 11.5C10.62 11.5 9.5 10.38 9.5 9C9.5 7.62 10.62 6.5 12 6.5C13.38 6.5 14.5 7.62 14.5 9C14.5 10.38 13.38 11.5 12 11.5Z"/>
    </svg>
    <div>
      <div class="hcm-banner-title">Khu vực phục vụ cố định: TP. Hồ Chí Minh</div>
      <p class="hcm-banner-desc">
        Hệ thống website Cơm Trưa Anh Béo <strong>chỉ tiếp nhận các đơn hàng có địa chỉ giao thuộc phạm vi TP. Hồ Chí Minh</strong> (22 quận/huyện và TP. Thủ Đức). Tất cả các yêu cầu đặt hàng có vị trí ngoài TP.HCM sẽ bị từ chối để đảm bảo chất lượng cơm trưa nóng hổi.
      </p>
    </div>
  </div>

  <!-- Section 1: Danh sách Đơn Vận Chuyển từ Database -->
  <div class="delivery-detail-box">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 8px;">
      <h3 style="margin: 0;">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
        </svg>
        Danh sách đơn vận chuyển Lalamove (<span id="totalDeliveryCount">0</span>)
      </h3>
      <div class="delivery-search-wrap">
        <input type="text" id="filterDeliveryKeyword" placeholder="Tìm theo mã đơn, khách hàng, SĐT..." class="form-control" style="font-size: 12px; height: 32px; width: 250px;" oninput="applyDeliveryFilter()">
      </div>
    </div>

    <div class="delivery-table-container">
      <table class="delivery-table">
        <thead>
          <tr>
            <th>Mã VC</th>
            <th>Mã Đơn</th>
            <th>Khách hàng</th>
            <th>Địa chỉ giao</th>
            <th>Cước thực tế</th>
            <th>Trạng thái VC</th>
            <th>Tài xế Lalamove</th>
            <th>Ngày tạo</th>
          </tr>
        </thead>
        <tbody id="deliveryTableBody">
          <tr>
            <td colspan="8" style="text-align: center; padding: 28px; color: var(--text-muted);">
              <div style="font-size: 26px; margin-bottom: 8px;">⏳</div>
              Đang tải danh sách đơn vận chuyển từ máy chủ...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Section 2: Công cụ Kiểm thử Endpoint Backend thực tế -->
  <div class="delivery-detail-box">
    <h3>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <path d="M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3M19 19H5V5H19V19M17 12H7V10H17V12M13 16H7V14H13V16M17 8H7V6H17V8Z"/>
      </svg>
      Kiểm thử trực tiếp Endpoint Backend Vận chuyển
    </h3>
    <p style="font-size: 12px; color: var(--text-secondary); margin-bottom: 16px;">
      Gửi yêu cầu kiểm tra tới các API Controller thực tế để đối chiếu tính năng và xử lý lỗi chuẩn từ Backend (không sử dụng dữ liệu giả).
    </p>

    <div class="api-test-grid">
      <!-- Tool 1: POST /api/van-chuyen/kiem-tra-dia-chi -->
      <div class="api-test-card">
        <div class="api-test-card-header">
          <strong>1. Xác thực địa chỉ giao hàng</strong>
          <span class="api-endpoint-badge">POST /api/van-chuyen/kiem-tra-dia-chi</span>
        </div>
        <div class="api-test-card-body">
          <label for="testAddressInput" class="setting-field-label">Địa chỉ cần kiểm tra tại TP.HCM:</label>
          <input type="text" id="testAddressInput" class="form-control" value="50 Lê Văn Việt, Hiệp Phú, TP. Thủ Đức, TP. Hồ Chí Minh" placeholder="Nhập địa chỉ giao hàng...">
          <button type="button" class="btn-api-test" id="btnTestAddress" onclick="executeTestAddress()">
            <span>🔍</span> Gửi kiểm tra địa chỉ
          </button>
          <div class="api-result-box" id="resultTestAddress">
            <span style="color: var(--text-muted); font-size: 11.5px;">Chưa gửi yêu cầu. Nhấn nút để kiểm tra phản hồi từ Backend.</span>
          </div>
        </div>
      </div>

      <!-- Tool 2: POST /api/van-chuyen/bao-gia -->
      <div class="api-test-card">
        <div class="api-test-card-header">
          <strong>2. Lấy báo giá Lalamove &amp; Miễn ship</strong>
          <span class="api-endpoint-badge">POST /api/van-chuyen/bao-gia</span>
        </div>
        <div class="api-test-card-body">
          <label for="testQuoteAddressInput" class="setting-field-label">Địa chỉ giao hàng:</label>
          <input type="text" id="testQuoteAddressInput" class="form-control" value="50 Lê Văn Việt, Hiệp Phú, TP. Thủ Đức, TP. Hồ Chí Minh" placeholder="Nhập địa chỉ giao...">
          
          <label for="testQuoteAmountInput" class="setting-field-label" style="margin-top: 8px;">Tiền hàng thử nghiệm (VNĐ):</label>
          <input type="number" id="testQuoteAmountInput" class="form-control" value="220000" min="0" step="10000" placeholder="VD: 220000">

          <button type="button" class="btn-api-test" id="btnTestQuote" onclick="executeTestQuote()">
            <span>💵</span> Gửi yêu cầu báo giá
          </button>
          <div class="api-result-box" id="resultTestQuote">
            <span style="color: var(--text-muted); font-size: 11.5px;">Chưa gửi yêu cầu. Nhấn nút để kiểm tra phản hồi từ Backend.</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<!-- =======================================================================
     COLUMN 3: RIGHT CONTEXTUAL ACTION & DETAILS PANEL (~390px)
     ======================================================================= -->
<aside class="right-action-panel">
  <!-- Top Header of Right Panel -->
  <div class="panel-header">
    <div class="panel-header-title-group">
      <h2>CHI TIẾT VẬN CHUYỂN</h2>
      <span id="panelSubtitle">Chọn đơn hàng để quản trị</span>
    </div>
  </div>

  <!-- State 1: Chưa chọn đơn -->
  <div class="panel-body" id="panelEmptyState">
    <div class="empty-selection-placeholder">
      <div class="empty-selection-icon">🛵</div>
      <h4>CHỌN MỘT ĐƠN VẬN CHUYỂN</h4>
      <p>Bấm vào bất kỳ dòng đơn vận chuyển nào trong danh sách bên trái để xem chi tiết cước phí, thông tin tài xế Lalamove và thao tác quản trị.</p>
    </div>
  </div>

  <!-- State 2: Đã chọn một đơn vận chuyển -->
  <div class="panel-body" id="panelDetailState" style="display: none;">
    <!-- Card Thông tin Đơn hàng & Vận chuyển -->
    <div class="delivery-settings-form-card">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; border-bottom: 1px dashed var(--border-light); padding-bottom: 8px;">
        <div>
          <span style="font-size: 11px; color: var(--text-muted); text-transform: uppercase;">Mã vận chuyển:</span>
          <strong id="detMaVc" style="font-size: 15px; color: var(--brand-burgundy); display: block;">#VC-0</strong>
        </div>
        <div style="text-align: right;">
          <span style="font-size: 11px; color: var(--text-muted); text-transform: uppercase;">Đơn hàng:</span>
          <strong id="detMaDon" style="font-size: 14px; color: #2E7D32; display: block;">#DH-0</strong>
        </div>
      </div>

      <div class="det-row">
        <span class="det-label">Khách hàng:</span>
        <strong class="det-value" id="detTenKhach">--</strong>
      </div>
      <div class="det-row">
        <span class="det-label">Số điện thoại:</span>
        <strong class="det-value" id="detSdtKhach">--</strong>
      </div>
      <div class="det-row" style="align-items: flex-start;">
        <span class="det-label">Địa chỉ nhận:</span>
        <span class="det-value" id="detDiaChi" style="font-weight: 600; text-align: right; max-width: 200px;">--</span>
      </div>
      <div class="det-row">
        <span class="det-label">Cước thực tế:</span>
        <strong class="det-value" id="detPhiThucTe" style="color: var(--brand-burgundy); font-size: 15px;">0đ</strong>
      </div>
      <div class="det-row">
        <span class="det-label">Trạng thái VC:</span>
        <span id="detTrangThaiBadge" class="badge-status-neutral">--</span>
      </div>
      <div class="det-row">
        <span class="det-label">Ngày tạo:</span>
        <span class="det-value" id="detNgayTao">--</span>
      </div>
    </div>

    <!-- Card Chi tiết Lalamove & Tài xế -->
    <div class="delivery-settings-form-card" style="margin-top: 14px;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; border-bottom: 1px dashed var(--border-light); padding-bottom: 6px;">
        <div style="display: flex; align-items: center; gap: 6px;">
          <span style="background: #FF5722; color: #fff; font-size: 10px; font-weight: 800; padding: 2px 6px; border-radius: 4px;">LALAMOVE</span>
          <strong style="font-size: 12.5px; color: var(--brand-burgundy);">Thông tin giao vận</strong>
        </div>
      </div>

      <div class="det-row">
        <span class="det-label">Lalamove Order ID:</span>
        <span class="det-value" id="detLalamoveOrderId" style="font-family: monospace; font-size: 11.5px;">Chưa liên kết</span>
      </div>
      <div class="det-row">
        <span class="det-label">Tài xế giao hàng:</span>
        <strong class="det-value" id="detTenTaiXe">Chưa có tài xế</strong>
      </div>
      <div class="det-row">
        <span class="det-label">SĐT tài xế:</span>
        <strong class="det-value" id="detSdtTaiXe">--</strong>
      </div>
      <div class="det-row" id="rowTrackingLink" style="display: none;">
        <span class="det-label">Theo dõi lộ trình:</span>
        <a href="#" id="linkTrackingLalamove" target="_blank" rel="noopener noreferrer" style="font-size: 11.5px; font-weight: 700; color: #1976D2; text-decoration: underline;">
          Xem vị trí tài xế ↗
        </a>
      </div>
    </div>

    <!-- Thao tác Admin: Gọi tài xế & Hủy giao vận -->
    <div style="margin-top: 18px; display: flex; flex-direction: column; gap: 10px;">
      <button type="button" class="btn-save-settings" id="btnAdminCallDriver" onclick="handleAdminCallDriver()" style="background: #E65100;">
        <svg viewBox="0 0 24 24">
          <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
        </svg>
        <span>🛵 Điều phối / Gọi tài xế Lalamove</span>
      </button>

      <button type="button" class="btn-api-test" id="btnAdminSyncDriver" onclick="handleAdminSyncDriver()" style="background: #1976D2; color: #fff; width: 100%; justify-content: center; height: 38px; display: none;">
        <span>🔄</span>
        <span>Cập nhật tiến độ / Tài xế từ Lalamove</span>
      </button>

      <button type="button" class="btn-cancel-delivery" id="btnAdminCancelDelivery" onclick="handleAdminCancelDelivery()">
        <span>✕</span>
        <span>Hủy yêu cầu giao hàng Lalamove</span>
      </button>
    </div>
  </div>
</aside>

@section Scripts {
    <script src="~/js/delivery.js" asp-append-version="true"></script>
}
