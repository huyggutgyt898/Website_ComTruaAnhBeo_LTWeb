@{
    ViewData["Title"] = "Quản lý món ăn";
    ViewData["ActiveNav"] = "dishes";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/adminpage.css" asp-append-version="true" />
}

<!-- =======================================================================
     COLUMN 2: CENTRAL WORKSPACE (LARGEST AREA, WARM CREAM BACKGROUND)
     ======================================================================= -->
<main class="center-workspace">
  <!-- Title & Headline -->
  <div class="workspace-top-bar">
    <div class="page-heading-group">
      <h1>QUẢN LÝ MÓN ĂN</h1>
      <p>Quản lý toàn diện thực đơn cơm trưa, giá niêm yết, size cơm và món thêm</p>
    </div>
  </div>

  <!-- KPI Stat Summary Pills -->
  <div class="kpi-pills-row">
    <div class="kpi-pill">
      <div class="kpi-pill-icon kpi-icon-total">🍚</div>
      <div class="kpi-pill-content">
        <span class="kpi-pill-label">Tổng món ăn</span>
        <span class="kpi-pill-val" id="statTotalDishes">44</span>
      </div>
    </div>
    <div class="kpi-pill">
      <div class="kpi-pill-icon kpi-icon-active">🟢</div>
      <div class="kpi-pill-content">
        <span class="kpi-pill-label">Đang bán (Hiện)</span>
        <span class="kpi-pill-val" id="statActiveDishes">38</span>
      </div>
    </div>
    <div class="kpi-pill">
      <div class="kpi-pill-icon kpi-icon-soldout">⚠️</div>
      <div class="kpi-pill-content">
        <span class="kpi-pill-label">Tạm hết món</span>
        <span class="kpi-pill-val" id="statSoldOutDishes">6</span>
      </div>
    </div>
    <div class="kpi-pill">
      <div class="kpi-pill-icon kpi-icon-hidden">👁️‍🗨️</div>
      <div class="kpi-pill-content">
        <span class="kpi-pill-label">Đang ẩn menu</span>
        <span class="kpi-pill-val" id="statHiddenDishes">4</span>
      </div>
    </div>
  </div>

  <!-- TAB SYSTEM: EXACTLY TWO TABS (TAB 1: MÓN ĂN, TAB 2: SIZE & MÓN THÊM) -->
  <div class="admin-tab-bar">
    <button class="tab-button active" id="tabBtnDishes" onclick="switchMainTab('dishes')">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <path d="M18.06 22.99H5.94C4.33 22.99 3 21.66 3 20.05V13.88C3 13.06 3.67 12.39 4.49 12.39H19.51C20.33 12.39 21 13.06 21 13.88V20.05C21 21.66 19.67 22.99 18.06 22.99M12 2C10.9 2 10 2.9 10 4V10H14V4C14 2.9 13.1 2 12 2M6 4C4.9 4 4 4.9 4 6V10H8V6C8 4.9 7.1 4 6 4M18 4C16.9 4 16 4.9 16 6V10H20V6C20 4.9 19.1 4 18 4Z"/>
      </svg>
      <span>1. Quản lý món ăn</span>
    </button>
    <button class="tab-button" id="tabBtnSizes" onclick="switchMainTab('sizes')">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <path d="M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3M19 19H5V5H19V19M17 12H7V10H17V12M13 16H7V14H13V16M17 8H7V6H17V8Z"/>
      </svg>
      <span>2. Size & Món thêm</span>
    </button>
  </div>

  <!-- TAB 1 CONTENT: QUẢN LÝ MÓN ĂN -->
  <section class="tab-view-content active" id="tabViewDishes">
    <!-- Search & Category Filters Bar (Center viewing controls only) -->
    <div class="search-filter-card">
      <div class="search-box">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="var(--text-muted)">
          <path d="M9.5 3A6.5 6.5 0 0 1 16 9.5c0 1.61-.59 3.09-1.56 4.23l.27.27h.79l5 5-1.5 1.5-5-5v-.79l-.27-.27A6.516 6.516 0 0 1 9.5 16 6.5 6.5 0 0 1 3 9.5 6.5 6.5 0 0 1 9.5 3m0 2C7 5 5 7 5 9.5S7 14 9.5 14 14 12 14 9.5 12 5 9.5 5Z"/>
        </svg>
        <input type="text" id="searchInput" class="search-input" placeholder="Tìm theo tên món ăn, mã món hoặc thành phần...">
      </div>

      <select id="filterCategory" class="select-filter">
        <option value="ALL">Tất cả danh mục cơm</option>
        <option value="Cơm sườn & Heo">Cơm sườn & Heo</option>
        <option value="Cơm gà">Cơm gà</option>
        <option value="Cơm bò">Cơm bò</option>
        <option value="Cơm cá & Hải sản">Cơm cá & Hải sản</option>
        <option value="Cơm chiên & Món đặc biệt">Cơm chiên & Món đặc biệt</option>
        <option value="Cơm chay & Thanh đạm">Cơm chay & Thanh đạm</option>
        <option value="Canh & Món canh gọi thêm">Canh & Món canh gọi thêm</option>
      </select>

      <select id="filterStatus" class="select-filter">
        <option value="ALL">Tất cả tình trạng bán</option>
        <option value="AVAILABLE">Còn món (Đang phục vụ)</option>
        <option value="SOLDOUT">Hết món (Tạm ngưng)</option>
        <option value="VISIBLE">Đang hiện trên website</option>
        <option value="HIDDEN">Đang ẩn khỏi website</option>
      </select>
    </div>

    <!-- Food List Table Container -->
    <div class="table-container">
      <table class="data-table" id="dishTable">
        <thead>
          <tr>
            <th style="width: 72px;">Ảnh</th>
            <th>Tên món ăn</th>
            <th>Phân loại</th>
            <th>Giá bán</th>
            <th>Tình trạng</th>
            <th>Website</th>
            <th style="text-align: right;">Thao tác</th>
          </tr>
        </thead>
        <tbody id="dishTableBody">
          <!-- Rendered via JS -->
        </tbody>
      </table>

      <div class="empty-state-card" id="dishEmptyState" style="display: none;">
        <div class="empty-state-icon">🍲</div>
        <div class="empty-state-title">Chưa có dữ liệu món ăn</div>
        <div class="empty-state-desc">Không tìm thấy món cơm nào phù hợp với từ khóa hoặc bộ lọc đã chọn.</div>
      </div>
    </div>

    <!-- Pagination Controls Bar -->
    <div class="pagination-bar">
      <span class="pagination-info" id="paginationInfo">Hiển thị 1 - 10 trên 44 món ăn</span>
      <div class="pagination-controls" id="paginationControls">
        <!-- Dynamic page buttons -->
      </div>
    </div>
  </section>

  <!-- TAB 2 CONTENT: SIZE & MÓN THÊM -->
  <section class="tab-view-content" id="tabViewSizes">
    <div class="sizes-tab-grid">
      <!-- Sub-block 1: Size Cơm List -->
      <div class="sub-table-card">
        <div class="sub-card-header">
          <div class="sub-card-title">
            <span>🍚 Danh sách Size cơm niêm yết</span>
          </div>
        </div>
        <div class="table-container" style="box-shadow: none; border-radius: 0;">
          <table class="data-table">
            <thead>
              <tr>
                <th>Mã size</th>
                <th>Tên Size</th>
                <th>Giá bù/chênh lệch</th>
                <th>Trạng thái</th>
              </tr>
            </thead>
            <tbody id="sizeTableBody">
              <!-- Rendered via JS -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- Sub-block 2: Topping & Món thêm List -->
      <div class="sub-table-card">
        <div class="sub-card-header">
          <div class="sub-card-title">
            <span>🍳 Topping & Món ăn kèm gọi thêm</span>
          </div>
        </div>
        <div class="table-container" style="box-shadow: none; border-radius: 0;">
          <table class="data-table">
            <thead>
              <tr>
                <th>Mã món</th>
                <th>Tên món thêm</th>
                <th>Đơn giá</th>
                <th>Tình trạng</th>
              </tr>
            </thead>
            <tbody id="toppingTableBody">
              <!-- Rendered via JS -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</main>

<!-- =======================================================================
     COLUMN 3: DEDICATED RIGHT ACTION & DETAIL PANEL (~390px)
     CRITICAL RULE: ALL CRUD ACTIONS, SAVES, EDITS, DELETES RESIDE HERE
     ======================================================================= -->
<aside class="right-action-panel">
  <!-- Top Header of Right Panel -->
  <div class="panel-header">
    <div class="panel-header-title-group">
      <h2 id="rightPanelTitle">CHỈNH SỬA MÓN ĂN</h2>
      <span id="rightPanelSubtitle">Chỉnh sửa thông số món được chọn</span>
    </div>
    <button type="button" class="btn-create-dish" id="btnCreateNewDish" onclick="triggerAddNewDish()">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
        <path d="M19 13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
      </svg>
      <span>Thêm món</span>
    </button>
  </div>

  <!-- Scrollable Form Container -->
  <div class="panel-body">
    <form id="foodItemForm" onsubmit="event.preventDefault();">
      @Html.AntiForgeryToken()
      
      <!-- Image Upload & Preview Card -->
      <div class="image-uploader-card">
        <img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=400&auto=format&fit=crop&q=80" 
             alt="Xem trước món ăn" 
             class="dish-preview-img" 
             id="formImgPreview">
        <div class="image-upload-controls">
          <span class="upload-hint-title">Hình ảnh món ăn thực tế</span>
          <p class="upload-hint-sub">Định dạng JPG, PNG hoặc WebP chất lượng cao</p>
          <div class="upload-btn-row">
            <input type="file" id="fileImageInput" accept="image/*" style="display: none;" onchange="handleImageFileSelected(this)">
            <button type="button" class="btn-secondary" onclick="document.getElementById('fileImageInput').click()">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                <path d="M9 16H15V10H19L12 3L5 10H9V16M5 18H19V20H5V18Z"/>
              </svg>
              <span>Tải ảnh lên</span>
            </button>
            <button type="button" class="btn-secondary" onclick="promptImageURL()">
              <span>Dán liên kết</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Basic Metadata Fields -->
      <div class="form-row">
        <div class="form-group flex-1">
          <label for="formDishId">Mã món ăn</label>
          <input type="text" id="formDishId" class="form-control" readonly value="MON-001">
        </div>
        <div class="form-group flex-2">
          <label for="formDishCategory">Nhóm thực đơn <span class="required">*</span></label>
          <select id="formDishCategory" class="form-control">
            <option value="Cơm sườn & Heo">Cơm sườn & Heo</option>
            <option value="Cơm gà">Cơm gà</option>
            <option value="Cơm bò">Cơm bò</option>
            <option value="Cơm cá & Hải sản">Cơm cá & Hải sản</option>
            <option value="Cơm chiên & Món đặc biệt">Cơm chiên & Món đặc biệt</option>
            <option value="Cơm chay & Thanh đạm">Cơm chay & Thanh đạm</option>
            <option value="Canh & Món canh gọi thêm">Canh & Món canh gọi thêm</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label for="formDishName">Tên món ăn cơm trưa <span class="required">*</span></label>
        <input type="text" id="formDishName" class="form-control" placeholder="Ví dụ: Cơm sườn bì chả nướng than" required>
      </div>

      <div class="form-group">
        <label for="formDishPrice">Giá bán niêm yết (VNĐ) <span class="required">*</span></label>
        <div class="price-input-wrapper">
          <input type="number" id="formDishPrice" class="form-control" placeholder="45000" min="0" step="1000" required>
          <span class="price-currency-tag">VNĐ</span>
        </div>
      </div>

      <div class="form-group">
        <label for="formDishDesc">Mô tả món ăn & Thành phần chính</label>
        <textarea id="formDishDesc" class="form-control" rows="3" placeholder="Sườn nướng mật ong than hồng thơm mềm, bì giòn dai thính vàng, chả trứng hấp béo ngậy..."></textarea>
      </div>

      <!-- Availability & Visibility Toggles (Distinct according to rule 5 & 8) -->
      <div class="switches-section">
        <div class="switch-row">
          <div class="switch-text-group">
            <span class="switch-title">Tình trạng phục vụ (Còn / Hết món)</span>
            <span class="switch-desc">Khi gạt tắt, hệ thống báo hết món và khách không thể đặt</span>
          </div>
          <label class="switch-control">
            <input type="checkbox" id="formSwitchAvailable" checked>
            <span class="switch-slider"></span>
          </label>
        </div>

        <div class="switch-row">
          <div class="switch-text-group">
            <span class="switch-title">Hiển thị trên website</span>
            <span class="switch-desc">Ẩn hoặc hiện món ăn độc lập với tình trạng còn món</span>
          </div>
          <label class="switch-control">
            <input type="checkbox" id="formSwitchVisible" checked>
            <span class="switch-slider"></span>
          </label>
        </div>
      </div>

      <!-- Toppings / Extras association -->
      <div class="form-group">
        <label>Món ăn kèm & Topping áp dụng</label>
        <div class="topping-checkbox-grid" id="dishToppingCheckboxes">
          <!-- Dynamically populated -->
        </div>
      </div>

    </form>
  </div>

  <!-- Action Buttons Footer -->
  <div class="panel-footer">
    <button type="button" class="btn-save" id="btnSaveDish" onclick="handleSaveDish()">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <path d="M15 9H5V5H15M12 19A3 3 0 0 1 9 16A3 3 0 0 1 12 13A3 3 0 0 1 15 16A3 3 0 0 1 12 19M17 3H5C3.89 3 3 3.9 3 5V19A2 2 0 0 0 5 21H19A2 2 0 0 0 21 19V7L17 3Z"/>
      </svg>
      <span id="saveBtnText">Lưu thay đổi</span>
    </button>

    <button type="button" class="btn-delete" id="btnDeleteDish" onclick="openDeleteConfirmModal()">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <path d="M19 4H15.5L14.5 3H9.5L8.5 4H5V6H19M6 19A2 2 0 0 0 8 21H16A2 2 0 0 0 18 19V7H6V19Z"/>
      </svg>
      <span>Xóa món</span>
    </button>
  </div>
</aside>

<!-- =========================================================================
     CONFIRMATION MODAL FOR DESTRUCTIVE ACTION (DELETE DISH)
     ========================================================================= -->
<div class="modal-backdrop" id="deleteConfirmModal">
  <div class="modal-card">
    <div class="modal-header">
      <div class="modal-icon-warning">⚠️</div>
      <h3 class="modal-title">Xác nhận xóa món ăn?</h3>
    </div>
    <div class="modal-body">
      <p>Bạn có chắc chắn muốn xóa món <strong id="deleteTargetDishName">Cơm sườn bì chả</strong> khỏi thực đơn?</p>
      <p class="modal-note">Hệ thống sẽ giữ lại bản sao dữ liệu trong các đơn hàng lịch sử để đảm bảo tính an toàn và minh bạch tài chính.</p>
    </div>
    <div class="modal-footer">
      <button type="button" class="modal-btn-cancel" onclick="closeDeleteConfirmModal()">Hủy thao tác</button>
      <button type="button" class="modal-btn-confirm" onclick="confirmDeleteDish()">Đồng ý xóa</button>
    </div>
  </div>
</div>

@section Scripts {
    <script src="~/js/adminpage.js" asp-append-version="true"></script>
}
