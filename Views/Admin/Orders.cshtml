@{
    ViewData["Title"] = "Quản lý đơn hàng";
    ViewData["ActiveNav"] = "orders";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/orders.css" asp-append-version="true" />
}

<!-- =======================================================================
     COLUMN 2: CENTRAL WORKSPACE (LARGEST AREA, WARM CREAM BACKGROUND)
     ======================================================================= -->
<main class="center-workspace">
  <div hidden>@Html.AntiForgeryToken()</div>
  <!-- Title & Headline -->
  <div class="workspace-top-bar">
    <div class="page-heading-group">
      <h1>QUẢN LÝ ĐƠN HÀNG</h1>
      <p>Xử lý tiếp nhận đơn cơm trưa, theo dõi quy trình bếp và kết nối giao vận Lalamove</p>
    </div>
  </div>

  <!-- KPI Status Pills Row -->
  <div class="order-kpi-grid">
    <div class="order-kpi-card order-kpi-total">
      <div class="kpi-icon-wrap">📋</div>
      <div class="kpi-data-wrap">
        <span class="kpi-label-text">Tổng đơn</span>
        <span class="kpi-count-num" id="kpiTotalOrders">0</span>
      </div>
    </div>
    <div class="order-kpi-card order-kpi-pending">
      <div class="kpi-icon-wrap">⏳</div>
      <div class="kpi-data-wrap">
        <span class="kpi-label-text">Chờ xác nhận</span>
        <span class="kpi-count-num" id="kpiPendingOrders">0</span>
      </div>
    </div>
    <div class="order-kpi-card order-kpi-prep">
      <div class="kpi-icon-wrap">🍳</div>
      <div class="kpi-data-wrap">
        <span class="kpi-label-text">Đang chế biến</span>
        <span class="kpi-count-num" id="kpiPrepOrders">0</span>
      </div>
    </div>
    <div class="order-kpi-card order-kpi-delivering">
      <div class="kpi-icon-wrap">🛵</div>
      <div class="kpi-data-wrap">
        <span class="kpi-label-text">Đang giao hàng</span>
        <span class="kpi-count-num" id="kpiDeliveringOrders">0</span>
      </div>
    </div>
    <div class="order-kpi-card order-kpi-completed">
      <div class="kpi-icon-wrap">✅</div>
      <div class="kpi-data-wrap">
        <span class="kpi-label-text">Hoàn thành</span>
        <span class="kpi-count-num" id="kpiCompletedOrders">0</span>
      </div>
    </div>
    <div class="order-kpi-card order-kpi-canceled">
      <div class="kpi-icon-wrap">✕</div>
      <div class="kpi-data-wrap">
        <span class="kpi-label-text">Đã hủy</span>
        <span class="kpi-count-num" id="kpiCanceledOrders">0</span>
      </div>
    </div>
  </div>

  <!-- Toolbar: Search & Filters -->
  <div class="order-toolbar-card">
    <div class="order-toolbar-top">
      <!-- Search Input -->
      <div class="order-search-box">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="var(--text-muted)">
          <path d="M9.5 3A6.5 6.5 0 0 1 16 9.5c0 1.61-.59 3.09-1.56 4.23l.27.27h.79l5 5-1.5 1.5-5-5v-.79l-.27-.27A6.516 6.516 0 0 1 9.5 16 6.5 6.5 0 0 1 3 9.5 6.5 6.5 0 0 1 9.5 3m0 2C7 5 5 7 5 9.5S7 14 9.5 14 14 12 14 9.5 12 5 9.5 5Z"/>
        </svg>
        <input type="text" id="searchOrderInput" class="order-search-input" placeholder="Tìm theo mã đơn (#DH-...), tên khách, số điện thoại...">
      </div>

      <!-- Status Select -->
      <select id="filterOrderStatus" class="order-select-filter">
        <option value="ALL">Tất cả trạng thái đơn</option>
        <option value="PENDING">Chờ xác nhận</option>
        <option value="CONFIRMED">Đã xác nhận</option>
        <option value="PREPARING">Đang chuẩn bị</option>
        <option value="FINDING_DRIVER">Đang tìm tài xế</option>
        <option value="DRIVER_ASSIGNED">Đã có tài xế</option>
        <option value="DELIVERING">Đang giao hàng</option>
        <option value="COMPLETED">Hoàn thành</option>
        <option value="CANCELED">Đã hủy</option>
        <option value="FAILED">Giao thất bại</option>
      </select>

      <!-- Payment Status Select -->
      <select id="filterPaymentStatus" class="order-select-filter">
        <option value="ALL">Tất cả thanh toán</option>
        <option value="PAID">Đã thanh toán</option>
        <option value="UNPAID">Chưa thanh toán</option>
      </select>

      <!-- Date Filters -->
      <div class="date-filter-wrap">
        <span class="date-filter-label">Từ:</span>
        <input type="date" id="filterOrderStartDate" class="date-filter-input">
        <span class="date-filter-label">Đến:</span>
        <input type="date" id="filterOrderEndDate" class="date-filter-input">
      </div>

      <!-- Reset Filter Button -->
      <button class="btn-filter-reset" onclick="resetAllFilters()" title="Đặt lại bộ lọc">
        <span>↺</span>
        <span>Đặt lại</span>
      </button>
      <button class="btn-refresh-orders" id="btnRefreshOrders" type="button" title="Tải lại dữ liệu đơn hàng">
        <span>↻</span>
        <span>Tải lại</span>
      </button>
    </div>

    <!-- Quick Status Filter Tabs -->
    <div class="quick-status-tabs">
      <button class="status-tab-btn active" data-status="ALL">
        <span>Tất cả</span>
      </button>
      <button class="status-tab-btn" data-status="PENDING">
        <span>Chờ xác nhận</span>
        <span class="tab-count" id="tabCountPending">0</span>
      </button>
      <button class="status-tab-btn" data-status="PREPARING">
        <span>Đang nấu</span>
      </button>
      <button class="status-tab-btn" data-status="DELIVERING">
        <span>Đang giao</span>
        <span class="tab-count" id="tabCountDelivering">0</span>
      </button>
      <button class="status-tab-btn" data-status="COMPLETED">
        <span>Hoàn thành</span>
        <span class="tab-count" id="tabCountCompleted">0</span>
      </button>
      <button class="status-tab-btn" data-status="CANCELED">
        <span>Đã hủy</span>
      </button>
    </div>
  </div>

  <!-- Bulk Actions Bar -->
  <div class="bulk-actions-banner" id="bulkActionsBanner">
    <div class="bulk-info-text">
      <span>☑ Đã chọn</span>
      <span class="bulk-count-pill" id="bulkCountNumber">0</span>
      <span>đơn hàng</span>
    </div>
    <div class="bulk-btn-group">
      <button class="bulk-action-btn bulk-btn-confirm" onclick="executeBulkAction('CONFIRM')">
        ✓ Xác nhận hàng loạt
      </button>
      <button class="bulk-action-btn bulk-btn-print" onclick="executeBulkAction('PRINT')">
        🖨️ In phiếu bếp
      </button>
      <button class="bulk-action-btn bulk-btn-cancel" onclick="executeBulkAction('CANCEL')">
        ✕ Hủy hàng loạt
      </button>
    </div>
  </div>

  <!-- Order List Table -->
  <div class="order-table-container" id="orderTableContainer">
    <table class="order-data-table">
      <thead>
        <tr>
          <th class="col-check">
            <input type="checkbox" id="selectAllOrders" title="Chọn tất cả đơn hàng">
          </th>
          <th>Mã đơn</th>
          <th>Khách hàng</th>
          <th>Món đã đặt</th>
          <th>Tổng tiền</th>
          <th>Thanh toán</th>
          <th>Trạng thái</th>
          <th>Thời gian</th>
          <th style="text-align: right;">Thao tác</th>
        </tr>
      </thead>
      <tbody id="orderTableBody">
        <!-- Dynamic rows rendered by JS -->
      </tbody>
    </table>

    <!-- Dedicated Empty State (Mandatory Vietnamese per AGENTS.md) -->
    <div class="order-empty-state-wrap" id="orderEmptyState" role="status" aria-live="polite">
      <div class="order-empty-icon">📦</div>
      <h3 class="order-empty-title" id="orderEmptyTitle">Chưa có đơn hàng</h3>
      <p class="order-empty-desc" id="orderEmptyDescription">Đơn hàng từ cơ sở dữ liệu sẽ xuất hiện tại đây sau khi được tạo.</p>
      <div style="display: flex; gap: 10px; flex-wrap: wrap; justify-content: center;">
        <button class="btn-refresh-orders" id="btnRefreshEmpty" type="button" onclick="loadOrders()">
          <span>↻</span>
          <span>Làm mới danh sách</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Pagination Bar -->
  <div class="order-toolbar-card" id="orderPaginationBar" style="display: none; flex-direction: row; justify-content: space-between; align-items: center; margin-top: -8px;">
    <span style="font-size: 13px; font-weight: 600; color: var(--text-secondary);" id="paginationInfoText">
      Hiển thị 0 - 0 trên 0 đơn hàng
    </span>
    <div id="paginationButtonsWrap" style="display: flex; gap: 6px;">
      <!-- Rendered via JS -->
    </div>
  </div>
</main>

<!-- =======================================================================
     COLUMN 3: RIGHT DETAIL & ACTION PANEL (~390px)
     ======================================================================= -->
<aside class="order-detail-panel" id="orderDetailPanel">
  <!-- Empty Placeholder when no order selected -->
  <div class="panel-empty-placeholder" id="panelEmptyPlaceholder">
    <div class="empty-icon">📝</div>
    <h3>CHỌN MỘT ĐƠN HÀNG</h3>
    <p>Bấm vào bất kỳ dòng đơn hàng nào trong danh sách bên trái để xem toàn bộ thông tin chi tiết, điều phối giao hàng Lalamove và thao tác nghiệp vụ.</p>
  </div>

  <!-- Detailed Content when order is selected -->
  <div id="panelDetailContent" style="display: none; flex-direction: column; height: 100%;">
    <!-- Header -->
    <div class="order-panel-header">
      <div class="order-panel-title-wrap">
        <h2 id="panelOrderIdCode">#DH-XXXX</h2>
        <span>Chi tiết & điều phối đơn</span>
      </div>
      <span class="status-pill status-pending" id="panelOrderStatusBadge">
        <span class="status-dot"></span>
        <span>Chờ xác nhận</span>
      </span>
    </div>

    <!-- Scrollable Body -->
    <div class="order-panel-body">
      <!-- 1. Customer Card -->
      <div class="panel-section-box">
        <div class="panel-section-header">
          <span>👤 Khách hàng & Giao nhận</span>
        </div>
        <div class="customer-detail-list">
          <div class="customer-detail-row">
            <span class="detail-icon">👤</span>
            <span class="detail-val" id="panelCustomerName">--</span>
          </div>
          <div class="customer-detail-row">
            <span class="detail-icon">📞</span>
            <span class="detail-val" id="panelCustomerPhone" style="font-family: 'Courier New', monospace; font-weight: 700;">--</span>
          </div>
          <div class="customer-detail-row">
            <span class="detail-icon">📍</span>
            <span class="detail-val" id="panelCustomerAddress">--</span>
          </div>
          <div class="order-note-callout" id="panelCustomerNoteWrap" style="display: none;">
            <strong>Ghi chú:</strong> <span id="panelCustomerNoteText">--</span>
          </div>
        </div>
      </div>

      <!-- 2. Ordered Dishes -->
      <div class="panel-section-box">
        <div class="panel-section-header">
          <span>🍚 Danh sách món đặt</span>
        </div>
        <div id="panelOrderedDishList">
          <!-- Rendered via JS -->
        </div>
      </div>

      <!-- 3. Cost & Payment -->
      <div class="panel-section-box">
        <div class="panel-section-header">
          <span>💰 Thanh toán & Chi phí</span>
          <button class="bulk-action-btn bulk-btn-confirm" id="btnConfirmPayment" type="button" onclick="confirmPayment()" style="font-size: 11px; padding: 4px 8px;">
            ✓ Xác nhận đã nhận tiền
          </button>
        </div>
        <div class="cost-summary-list">
          <div class="cost-row">
            <span>Tiền món:</span>
            <span id="panelSubtotalVal" style="font-weight: 700;">0đ</span>
          </div>
          <div class="cost-row">
            <span>Khuyến mãi / Giảm giá:</span>
            <span id="panelDiscountVal" style="font-weight: 700; color: var(--success);">0đ</span>
          </div>
          <div class="cost-row">
            <span>Phí giao hàng:</span>
            <span id="panelShippingFeeVal" style="font-weight: 700;">0đ</span>
          </div>
          <div class="cost-row grand-total">
            <span>TỔNG CỘNG:</span>
            <span class="cost-val" id="panelGrandTotalVal">0đ</span>
          </div>
        </div>
        <div style="margin-top: 10px; display: flex; justify-content: space-between; align-items: center; font-size: 12px;">
          <span id="panelPayMethodName" style="color: var(--text-secondary); font-weight: 600;">--</span>
          <span class="pay-status-badge pay-unpaid" id="panelPayStatusBadge">⏳ Chưa thanh toán</span>
        </div>
      </div>

      <!-- 4. Lalamove Delivery Section -->
      <div class="lalamove-card" id="panelLalamoveCard">
        <div class="lalamove-brand-header">
          <div style="display: flex; align-items: center; gap: 6px;">
            <span class="lalamove-logo-badge">LALAMOVE</span>
            <span style="font-size: 12px; font-weight: 700; color: var(--brand-burgundy);">Giao vận hỏa tốc</span>
          </div>
          <span id="lalamoveStatusText" style="font-size: 11px; font-weight: 700;">--</span>
        </div>

        <!-- Driver Info Box (shown if driver assigned) -->
        <div class="driver-info-box" id="panelDriverInfoBox" style="display: none;">
          <div class="driver-avatar">🛵</div>
          <div class="driver-details">
            <span class="driver-name" id="driverNameText">--</span>
            <span class="driver-plate" id="driverPlateText">--</span>
            <span style="font-size: 11px; color: var(--text-secondary);" id="driverPhoneText">--</span>
          </div>
        </div>
        <a id="driverTrackingLink" href="#" target="_blank" rel="noopener noreferrer"
           style="display: none; margin-top: 8px; font-size: 12px; font-weight: 700;">
          Theo dõi chuyến trên Lalamove
        </a>

        <div style="display: flex; justify-content: space-between; font-size: 11.5px; margin-top: 6px;">
          <span style="color: var(--text-secondary);">COD tài xế thu hộ:</span>
          <strong id="lalamoveCODAmount" style="color: var(--brand-burgundy);">0đ</strong>
        </div>
      </div>

      <!-- 5. Order Progression Timeline -->
      <div class="panel-section-box">
        <div class="panel-section-header">
          <span>⏱️ Tiến trình đơn hàng</span>
        </div>
        <div class="order-timeline-box" id="panelTimelineSteps">
          <!-- Rendered via JS -->
        </div>
      </div>

      <!-- 6. History Log -->
      <div class="panel-section-box">
        <div class="panel-section-header">
          <span>📜 Nhật ký thay đổi</span>
        </div>
        <div id="panelHistoryList">
          <!-- Rendered via JS -->
        </div>
      </div>
    </div>

    <!-- Sticky Footer with Contextual Action Buttons -->
    <div class="order-panel-actions-footer" id="panelActionsFooter">
      <!-- Rendered dynamically by renderContextualActions(order) -->
    </div>
  </div>
</aside>

<!-- =========================================================================
     MODALS (CANCEL ORDER & KITCHEN TICKET PRINT PREVIEW)
     ========================================================================= -->

<!-- Modal 1: Hủy đơn hàng -->
<div class="admin-modal-backdrop" id="cancelOrderModal">
  <div class="admin-modal-box">
    <div class="admin-modal-header">
      <h3>XÁC NHẬN HỦY ĐƠN HÀNG <span id="cancelOrderIdTarget"></span></h3>
      <button class="btn-modal-close" onclick="closeCancelOrderModal()">✕</button>
    </div>
    <div class="admin-modal-body">
      <p style="font-size: 13.5px; color: var(--danger); margin-bottom: 14px; font-weight: 600;">
        ⚠️ Thao tác này sẽ dừng toàn bộ quy trình chế biến và giao hàng của đơn.
      </p>

      <div style="margin-bottom: 14px;">
        <label style="display: block; font-size: 12.5px; font-weight: 700; color: var(--brand-burgundy); margin-bottom: 6px;">
          Lý do hủy đơn <span style="color: var(--danger);">*</span>
        </label>
        <select id="cancelReasonSelect" class="order-select-filter" style="width: 100%;">
          <option value="">-- Chọn lý do hủy --</option>
          <option value="Khách hàng yêu cầu hủy">Khách hàng gọi điện yêu cầu hủy</option>
          <option value="Quán hết món / nguyên liệu">Quán tạm hết món hoặc nguyên liệu</option>
          <option value="Không liên lạc được khách hàng">Không gọi được cho khách để xác nhận</option>
          <option value="Quán quá tải giờ cao điểm">Quán quá tải không kịp chế biến</option>
          <option value="Không tìm được tài xế giao">Không tìm được tài xế giao hàng Lalamove</option>
          <option value="Lý do khác">Lý do khác</option>
        </select>
      </div>

      <div>
        <label style="display: block; font-size: 12.5px; font-weight: 700; color: var(--brand-burgundy); margin-bottom: 6px;">
          Ghi chú chi tiết (nếu có)
        </label>
        <textarea id="cancelReasonDetails" class="order-search-input" style="height: 72px; padding: 10px; resize: vertical;" placeholder="Nhập thêm chi tiết nếu cần..."></textarea>
      </div>
    </div>
    <div class="admin-modal-footer">
      <button class="bulk-action-btn bulk-btn-print" onclick="closeCancelOrderModal()">Đóng</button>
      <button class="bulk-action-btn bulk-btn-cancel" onclick="submitCancelOrder()">Xác nhận hủy đơn</button>
    </div>
  </div>
</div>

<!-- Modal 2: In phiếu bếp & Hóa đơn -->
<div class="admin-modal-backdrop" id="printTicketModal">
  <div class="admin-modal-box">
    <div class="admin-modal-header">
      <h3>XEM TRƯỚC PHIẾU BẾP / GIAO HÀNG</h3>
      <button class="btn-modal-close" onclick="closePrintTicketModal()">✕</button>
    </div>
    <div class="admin-modal-body">
      <div class="kitchen-ticket-preview" id="printableTicketArea">
        <div class="ticket-header">
          <div class="ticket-brand">CƠM TRƯA ANH BÉO</div>
          <div style="font-size: 12px;">Hotline: 090 123 4567</div>
          <div class="ticket-id" id="ticketOrderId">#DH-XXXX</div>
          <div style="font-size: 11px;" id="ticketPrintTime">--</div>
        </div>

        <div style="font-size: 12px; margin-bottom: 8px;">
          <div>Khách: <strong id="ticketCustomerName">--</strong> (<span id="ticketCustomerPhone">--</span>)</div>
          <div>Đ/c: <span id="ticketCustomerAddress">--</span></div>
          <div>Ghi chú: <strong id="ticketCustomerNote">--</strong></div>
        </div>

        <table class="ticket-table">
          <thead>
            <tr>
              <th>Món</th>
              <th style="text-align: center;">SL</th>
              <th style="text-align: right;">Tiền</th>
            </tr>
          </thead>
          <tbody id="ticketItemsBody">
            <!-- Rendered via JS -->
          </tbody>
        </table>

        <div class="ticket-totals">
          <div style="display: flex; justify-content: space-between; font-weight: 800; font-size: 14px;">
            <span>TỔNG TIỀN:</span>
            <span id="ticketTotalAmount">0đ</span>
          </div>
          <div style="display: flex; justify-content: space-between; font-size: 11.5px;">
            <span>Thanh toán:</span>
            <strong id="ticketPaymentStatus">CHƯA THANH TOÁN</strong>
          </div>
        </div>

        <div style="text-align: center; font-size: 11px; margin-top: 14px; border-top: 1px dashed #212121; padding-top: 8px;">
          Chúc quý khách bữa trưa ngon miệng!
        </div>
      </div>
    </div>
    <div class="admin-modal-footer">
      <button class="bulk-action-btn bulk-btn-print" onclick="closePrintTicketModal()">Đóng</button>
      <button class="bulk-action-btn bulk-btn-confirm" onclick="triggerNativePrint()">
        🖨️ In ngay
      </button>
    </div>
  </div>
</div>

@section Scripts {
    <script src="~/js/orders.js" asp-append-version="true"></script>
}
