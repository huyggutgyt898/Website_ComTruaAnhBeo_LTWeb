@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CƠM TRƯA ANH BÉO - Cùng Anh Béo thưởng thức cơm trưa nóng hổi mỗi ngày</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/index.css" asp-append-version="true" />
</head>
<body class="min-h-screen flex flex-col justify-between">

  <!-- ================= HEADER (PHONG CÁCH PHÚC LỘC THỌ) ================= -->
  <header class="bg-plt-brown text-white sticky top-0 z-40 shadow-lg border-b border-amber-900/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-1 sm:gap-3">
      <!-- Brand Logo -->
      <button id="btnLogoHome" type="button" class="min-w-0 text-left group focus:outline-none flex items-center gap-2 sm:gap-3">
        <div class="w-10 h-10 sm:w-12 sm:h-12 shrink-0 rounded-xl bg-amber-500/20 border-2 border-plt-gold flex items-center justify-center shadow-inner">
          <span class="text-2xl" role="img" aria-label="rice">🍚</span>
        </div>
        <div class="min-w-0 max-w-[125px] sm:max-w-none">
          <div class="hidden sm:block text-plt-gold font-brand font-extrabold text-xs sm:text-sm tracking-wider uppercase leading-tight group-hover:text-amber-300 transition">
            ComTruaAnhBeo.vn
          </div>
          <div class="text-white font-brand font-black text-base sm:text-2xl tracking-tight uppercase leading-tight sm:leading-none mt-0.5">
            CƠM TRƯA ANH BÉO
          </div>
        </div>
      </button>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-6 text-xs xl:text-sm font-bold tracking-wide uppercase">
        <button type="button" data-nav="home" class="nav-tab-btn text-plt-gold hover:text-amber-300 transition py-2 border-b-2 border-plt-gold">
          VỀ ANH BÉO
        </button>
        <button type="button" data-nav="menu" class="nav-tab-btn text-white hover:text-plt-gold transition py-2 border-b-2 border-transparent">
          THỰC ĐƠN
        </button>
        <button type="button" data-nav="coupon" class="nav-tab-btn text-white hover:text-plt-gold transition py-2 border-b-2 border-transparent">
          MÃ KHUYẾN MÃI
        </button>
        <button type="button" data-nav="reviews" class="nav-tab-btn text-white hover:text-plt-gold transition py-2 border-b-2 border-transparent">
          ĐÁNH GIÁ QUÁN
        </button>
      </nav>

      <!-- Right Action Icons: User Auth, Shopping Cart -->
      <div class="shrink-0 flex items-center gap-1.5 sm:gap-3">
        <!-- Auth Button (Đăng nhập / Đăng xuất) -->
        <button id="btnHeaderAuth" type="button"
                aria-label="Đăng nhập" class="shrink-0 px-2 sm:px-3 py-2 rounded-full border-2 border-plt-gold/80 text-xs sm:text-sm font-bold text-plt-gold hover:bg-plt-gold hover:text-amber-950 transition flex items-center gap-1.5">
          <span>👤</span>
          <span id="headerAuthLabel" class="hidden sm:inline">Đăng nhập</span>
        </button>

        <button id="btnHeaderCart" type="button"
                aria-label="Mở giỏ hàng và đặt hàng"
                title="Mở giỏ hàng và đặt hàng"
                class="relative w-11 h-11 shrink-0 rounded-full bg-amber-950/80 border-2 border-plt-gold flex items-center justify-center text-plt-gold hover:bg-plt-gold hover:text-amber-950 transition pulse-gold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2 29m12-29l2 29m-6-23a1 1 0 11-2 0 1 1 0 012 0zm8 0a1 1 0 11-2 0 1 1 0 012 0z" />
            <circle cx="9" cy="19" r="1.7" fill="currentColor"/>
            <circle cx="17" cy="19" r="1.7" fill="currentColor"/>
          </svg>
          <span id="cartCountBadge" class="absolute -top-1.5 -right-1.5 bg-red-600 text-white text-[11px] font-extrabold w-5 h-5 rounded-full flex items-center justify-center border border-white shadow">
            0
          </span>
        </button>

        <!-- Mobile Menu Toggle -->
        <button id="btnMobileMenu" type="button" class="lg:hidden shrink-0 p-2 rounded-lg text-plt-gold border border-plt-gold/50 hover:bg-amber-900/40">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Bar -->
    <div id="mobileNavMenu" class="hidden lg:hidden bg-plt-brown-dark border-t border-amber-900/60 px-4 py-3 space-y-2">
      <div class="grid grid-cols-2 gap-2 text-xs font-bold uppercase">
        <button type="button" data-nav="home" class="nav-tab-btn text-left px-3 py-2.5 rounded-lg bg-amber-900/40 text-plt-gold">🏠 Về Anh Béo</button>
        <button type="button" data-nav="menu" class="nav-tab-btn text-left px-3 py-2.5 rounded-lg bg-amber-900/20 text-white">🍱 Thực đơn</button>
        <button type="button" data-nav="coupon" class="nav-tab-btn text-left px-3 py-2.5 rounded-lg bg-amber-900/20 text-white">🎟️ Mã khuyến mãi</button>
        <button type="button" data-nav="reviews" class="nav-tab-btn text-left px-3 py-2.5 rounded-lg bg-amber-900/20 text-white">⭐ Đánh giá quán</button>
      </div>
    </div>
  </header>

  <!-- ================= MAIN CONTENT CONTAINER ================= -->
  <main class="flex-grow">

    <!-- ================= VIEW 1: TRANG CHỦ & THỰC ĐƠN (GIỐNG CƠM TẤM PHÚC LỘC THỌ) ================= -->
    <section id="view-home" class="space-y-10 pb-12">

      <!-- HERO BANNER (MÂM CƠM TẤM SƯỜN BÌ CHẢ HEO QUAY TRÊN Mẹt TRE LÁ CHUỐI) -->
      <div class="relative w-full h-[380px] sm:h-[470px] lg:h-[540px] overflow-hidden bg-stone-900">
        <img src="/images/hero.jpg"
             alt="Mâm Cơm Trưa Anh Béo"
             class="w-full h-full object-cover object-center opacity-90 scale-105 transition duration-700" />
        <div class="absolute inset-0 bg-gradient-to-r from-[#330D0A]/90 via-[#4A1511]/65 to-transparent flex items-center">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
            <div class="max-w-2xl space-y-4">
              <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-plt-gold text-amber-950 font-extrabold text-xs sm:text-sm uppercase tracking-wider shadow">
                <span>🔥</span> Cửa hàng duy nhất tại 450 Lê Văn Việt, TP.HCM
              </div>
              <h1 class="font-brand font-black text-3xl sm:text-5xl lg:text-6xl text-white uppercase tracking-tight leading-none drop-shadow-md">
                CƠM TRƯA <span class="text-plt-gold">ANH BÉO</span>
              </h1>
              <p class="text-amber-50 text-base sm:text-xl font-medium leading-relaxed drop-shadow">
                “Cùng Anh Béo thưởng thức cơm trưa nóng hổi mỗi ngày. Ghé ngay Cơm trưa Anh Béo để trải nghiệm.”
              </p>
              <div class="pt-2 flex flex-wrap items-center gap-3">
                <button id="btnHeroWatchMenu" type="button"
                        class="px-6 py-3.5 rounded-xl bg-plt-gold hover:bg-amber-400 text-amber-950 font-brand font-black text-sm sm:text-base uppercase tracking-wide shadow-lg transition transform hover:-translate-y-0.5 flex items-center gap-2">
                  <span>🍽️</span> XEM MENU &amp; ĐẶT MÓN NGAY
                </button>
                <a href="https://www.tiktok.com/@@2hoanghieu7258" target="_blank" rel="noopener noreferrer"
                   class="px-5 py-3.5 rounded-xl bg-white/15 hover:bg-white/25 backdrop-blur-sm text-white border border-white/40 font-bold text-sm sm:text-base transition flex items-center gap-2">
                  <svg class="w-5 h-5 fill-current text-plt-gold" viewBox="0 0 24 24">
                    <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
                  </svg>
                  <span>TikTok @@hoanghieu7258</span>
                </a>
              </div>
              <div class="pt-2 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs sm:text-sm text-amber-200 font-semibold">
                <span>📍 450 Lê Văn Việt, P. Tăng Nhơn Phú, TP.HCM</span>
                <span>📞 0775058143 – Mr. Khoa (Zalo: 0775058143)</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ================= KHU VỰC MENU MÓN CHÍNH ================= -->
      <div id="menuSectionAnchor" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-2 space-y-6">
        <!-- Tiêu đề Menu & Thanh tìm kiếm / Lọc danh mục -->
        <div class="bg-plt-brown text-white rounded-2xl p-6 sm:p-8 shadow-lg flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">
          <div class="space-y-1.5">
            <div class="inline-flex items-center gap-2 text-plt-gold text-xs font-extrabold uppercase tracking-widest">
              <span>🍚</span> THỰC ĐƠN CHÍNH THỨC • CƠM TRƯA ANH BÉO
            </div>
            <h2 class="font-brand font-black text-2xl sm:text-3xl uppercase">
              THỰC ĐƠN MÓN CHÍNH
            </h2>
            <p class="text-amber-100/90 text-xs sm:text-sm">
              <span id="menuItemCount" aria-live="polite">Đang tải thực đơn...</span>
              <span> · </span>
              Bấm vào ảnh để xem chi tiết và món ăn kèm; thêm món vào giỏ để thanh toán.
            </p>
          </div>

          <!-- Ô tìm kiếm món ăn -->
          <div class="w-full lg:w-80">
            <div class="relative">
              <input id="inputSearchMenu" type="text"
                     placeholder="Tìm món chính..."
                     class="w-full pl-10 pr-4 py-3 rounded-xl bg-white text-stone-900 placeholder-stone-400 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-plt-gold shadow-inner" />
              <span class="absolute left-3.5 top-3 text-stone-400">🔍</span>
            </div>
          </div>
        </div>

        <!-- Bộ lọc Danh mục + Tóm tắt Giỏ hàng nhanh -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-4 rounded-2xl shadow-sm border border-stone-200 sticky top-20 z-30">
          <div class="flex flex-wrap items-center gap-2" id="categoryFilterBar">
            <span class="text-xs text-stone-500" aria-live="polite">Đang tải danh mục...</span>
          </div>

          <div class="flex items-center justify-between md:justify-end gap-3 border-t md:border-t-0 pt-3 md:pt-0 border-stone-200">
            <div class="text-xs sm:text-sm">
              <span class="text-stone-500 font-medium">Đã chọn:</span>
              <strong id="stickyCartCount" class="text-plt-brown font-extrabold">0 món</strong>
              <span class="mx-1 text-stone-300">|</span>
              <strong id="stickyCartTotal" class="text-red-600 font-black">0đ</strong>
            </div>
            <button id="btnStickyGoCheckout" type="button"
                    class="px-4 py-2.5 rounded-xl bg-plt-gold hover:bg-amber-400 text-amber-950 font-brand font-extrabold text-xs sm:text-sm uppercase shadow transition flex items-center gap-1.5">
              <span>🛒 Tiến hành Đặt hàng</span>
              <span>→</span>
            </button>
          </div>
        </div>

        <!-- Lưới món chính đang còn món -->
        <div id="menuGridContainer" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
          <!-- Render tự động bằng JS từ dữ liệu SQL Server MonAn -->
        </div>
      </div>
    </section>

    <section id="view-product-detail" class="hidden max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div id="productDetailContent"></div>
    </section>

    <section id="view-checkout" class="hidden max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <header class="mb-6 flex flex-col gap-4 border-b border-stone-200 pb-5 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <button id="btnBackToMenuFromCheckout" type="button" class="text-sm font-bold text-plt-brown hover:underline">
            ← Tiếp tục chọn món
          </button>
          <h1 class="mt-2 font-brand text-2xl font-black uppercase text-plt-brown">Đặt hàng</h1>
        </div>
        <ol class="grid w-full grid-cols-3 gap-1 rounded-lg bg-stone-100 p-1 text-center text-[11px] font-extrabold uppercase sm:w-auto sm:min-w-[520px] sm:text-xs">
          <li id="stepBadge1" class="rounded-md bg-plt-brown px-2 py-2 text-plt-gold">1. Khách hàng</li>
          <li id="stepBadge2" class="rounded-md px-2 py-2 text-stone-600">2. Đơn hàng</li>
          <li id="stepBadge3" class="rounded-md px-2 py-2 text-stone-600">3. Thanh toán</li>
        </ol>
      </header>

      <div id="checkoutContentGrid" class="grid grid-cols-1 items-start gap-6 lg:grid-cols-12">
        <div id="checkoutMainColumn" class="space-y-5 lg:col-span-7">
          <section id="customerStepPanel" class="space-y-5 rounded-xl border border-stone-200 bg-white p-5 sm:p-6">
            <div class="border-b border-stone-200 pb-3">
              <h2 class="font-brand text-lg font-extrabold uppercase text-plt-brown">Thông tin khách hàng</h2>
              <p class="mt-1 text-xs text-stone-500">Các mục có dấu * là bắt buộc. Không cần đăng nhập để đặt hàng.</p>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="orderFullName" class="mb-1 block text-xs font-bold uppercase text-stone-700">Họ và tên *</label>
                <input id="orderFullName" type="text" required maxlength="100" autocomplete="name"
                       placeholder="Nhập họ và tên"
                       class="w-full rounded-lg border border-stone-300 bg-white px-3.5 py-2.5 text-base focus:border-plt-brown focus:outline-none focus:ring-2 focus:ring-amber-300 sm:text-sm" />
              </div>
              <div>
                <label for="orderPhone" class="mb-1 block text-xs font-bold uppercase text-stone-700">Số điện thoại *</label>
                <input id="orderPhone" type="tel" required maxlength="10" inputmode="numeric" autocomplete="tel"
                       placeholder="0909123456"
                       class="w-full rounded-lg border border-stone-300 bg-white px-3.5 py-2.5 text-base focus:border-plt-brown focus:outline-none focus:ring-2 focus:ring-amber-300 sm:text-sm" />
              </div>
              <div class="sm:col-span-2">
                <label for="orderEmail" class="mb-1 block text-xs font-bold uppercase text-stone-700">Email <span class="font-normal normal-case text-stone-500">(không bắt buộc)</span></label>
                <input id="orderEmail" type="email" maxlength="150" autocomplete="email"
                       placeholder="ban@email.com"
                       class="w-full rounded-lg border border-stone-300 bg-white px-3.5 py-2.5 text-base focus:border-plt-brown focus:outline-none focus:ring-2 focus:ring-amber-300 sm:text-sm" />
              </div>
              <div class="sm:col-span-2">
                <label for="orderAddress" class="mb-1 block text-xs font-bold uppercase text-stone-700">Địa chỉ giao hàng *</label>
                <input id="orderAddress" type="text" required maxlength="255" autocomplete="street-address"
                       placeholder="Số nhà, tên đường, phường/xã..."
                       class="w-full rounded-lg border border-stone-300 bg-white px-3.5 py-2.5 text-base focus:border-plt-brown focus:outline-none focus:ring-2 focus:ring-amber-300 sm:text-sm" />
                <button id="btnUseCurrentLocation" type="button" class="mt-2 text-xs font-bold text-plt-brown underline">
                  Dùng vị trí hiện tại
                </button>
                <p id="deliveryLocationStatus" class="mt-1 text-xs text-stone-500" aria-live="polite">Nhập địa chỉ cụ thể hoặc chọn vị trí hiện tại để lấy báo giá giao hàng Lalamove.</p>
              </div>
              <div class="sm:col-span-2">
                <label for="orderNote" class="mb-1 block text-xs font-bold uppercase text-stone-700">Ghi chú đơn hàng <span class="font-normal normal-case text-stone-500">(không bắt buộc)</span></label>
                <textarea id="orderNote" maxlength="500" rows="3" placeholder="Ghi chú cho quán hoặc tài xế"
                          class="w-full rounded-lg border border-stone-300 bg-white px-3.5 py-2.5 text-base focus:border-plt-brown focus:outline-none focus:ring-2 focus:ring-amber-300 sm:text-sm"></textarea>
              </div>
            </div>
            <p id="checkoutFormError" class="min-h-5 text-sm text-red-700" aria-live="polite"></p>
            <div class="flex justify-end border-t border-stone-200 pt-4">
              <button id="btnConfirmOrderStep1" type="button" class="rounded-md bg-plt-brown px-6 py-3 font-brand text-sm font-extrabold uppercase text-white hover:bg-amber-900 disabled:cursor-not-allowed disabled:opacity-50">
                Tiếp theo
              </button>
            </div>
          </section>

          <section id="orderDetailsStepPanel" class="hidden space-y-5 rounded-xl border border-stone-200 bg-white p-5 sm:p-6">
            <div class="flex items-start justify-between gap-3 border-b border-stone-200 pb-3">
              <div>
                <h2 class="font-brand text-lg font-extrabold uppercase text-plt-brown">Thông tin đơn hàng</h2>
                <p class="mt-1 text-xs text-stone-500">Kiểm tra người nhận và địa chỉ trước khi chọn thanh toán.</p>
              </div>
              <button id="btnBackToCustomer" type="button" class="shrink-0 text-xs font-bold text-plt-brown underline">Chỉnh sửa</button>
            </div>
            <dl class="space-y-3 text-sm">
              <div class="flex justify-between gap-4"><dt class="text-stone-500">Người nhận</dt><dd id="reviewName" class="text-right font-bold"></dd></div>
              <div class="flex justify-between gap-4"><dt class="text-stone-500">Số điện thoại</dt><dd id="reviewPhone" class="text-right font-bold"></dd></div>
              <div class="flex justify-between gap-4"><dt class="text-stone-500">Email</dt><dd id="reviewEmail" class="text-right font-bold"></dd></div>
              <div class="flex justify-between gap-4"><dt class="text-stone-500">Địa chỉ giao</dt><dd id="reviewAddress" class="max-w-[70%] text-right font-bold"></dd></div>
              <div class="flex justify-between gap-4"><dt class="text-stone-500">Ghi chú</dt><dd id="reviewNote" class="max-w-[70%] text-right"></dd></div>
              <div class="flex justify-between gap-4 border-t border-stone-200 pt-3"><dt class="text-stone-500">Phương thức giao</dt><dd class="text-right font-bold">Giao hàng tận nơi</dd></div>
            </dl>
            <p id="orderStepError" class="min-h-5 text-sm text-red-700" aria-live="polite"></p>
            <div class="flex justify-between gap-3 border-t border-stone-200 pt-4">
              <button id="btnBackToCustomerFromReview" type="button" class="rounded-md border border-stone-400 px-5 py-3 font-bold text-stone-800 hover:bg-stone-100">Quay lại</button>
              <button id="btnProceedToPayment" type="button" class="rounded-md bg-plt-brown px-6 py-3 font-brand text-sm font-extrabold uppercase text-white hover:bg-amber-900 disabled:cursor-not-allowed disabled:opacity-50">Tiếp theo</button>
            </div>
          </section>

          <section id="paymentStepPanel" class="hidden space-y-5 rounded-xl border border-stone-200 bg-white p-5 sm:p-6">
            <div class="border-b border-stone-200 pb-3">
              <h2 class="font-brand text-lg font-extrabold uppercase text-plt-brown">Phương thức thanh toán</h2>
              <p class="mt-1 text-xs text-stone-500">Chọn thanh toán khi nhận hàng hoặc chuyển khoản ngân hàng.</p>
            </div>
            <div class="space-y-2" id="paymentMethodOptions">
              <label class="payment-method-card flex cursor-pointer items-center gap-3 rounded-lg border-2 border-stone-200 bg-white p-4">
                <input type="radio" name="paymentMethod" value="COD" checked class="h-4 w-4 accent-plt-brown" />
                <span class="min-w-0 flex-1"><strong class="block text-sm">Thanh toán khi nhận hàng</strong><span class="text-xs text-stone-500">Thanh toán trực tiếp cho tài xế khi nhận món.</span></span>
              </label>
              <label class="payment-method-card flex cursor-pointer items-center gap-3 rounded-lg border-2 border-stone-200 bg-white p-4">
                <input type="radio" name="paymentMethod" value="BANK" class="h-4 w-4 accent-plt-brown" />
                <span class="min-w-0 flex-1"><strong class="block text-sm">Chuyển khoản ngân hàng</strong><span class="text-xs text-stone-500">MB Bank · 0961016972. Mã QR thanh toán sẽ hiển thị sau khi đặt hàng.</span></span>
              </label>
            </div>
            <div id="paymentInstructionBox" class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm" aria-live="polite">
              <strong>Thanh toán khi nhận hàng</strong>
              <p class="mt-1">Vui lòng thanh toán trực tiếp cho tài xế khi nhận món.</p>
            </div>
            <p id="paymentError" class="min-h-5 text-sm text-red-700" aria-live="polite"></p>
            <div class="flex justify-between gap-3 border-t border-stone-200 pt-4">
              <button id="btnBackToOrderDetails" type="button" class="rounded-md border border-stone-400 px-5 py-3 font-bold text-stone-800 hover:bg-stone-100">Quay lại</button>
              <button id="btnCompletePaymentFinal" type="button" class="rounded-md bg-plt-brown px-6 py-3 font-brand text-sm font-extrabold uppercase text-white hover:bg-amber-900 disabled:cursor-not-allowed disabled:opacity-50">
                Đặt hàng
              </button>
            </div>
          </section>

          <section id="orderPlacedPanel" class="hidden rounded-xl border border-stone-200 bg-white p-6 text-center">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100 text-2xl text-emerald-700" aria-hidden="true">✓</div>
            <h2 class="font-brand text-xl font-black uppercase text-plt-brown">Đặt hàng thành công</h2>
            <p class="mt-2 text-sm text-stone-600">Mã tra cứu đơn hàng</p>
            <p id="orderPlacedTrackingCode" class="mt-1 font-mono text-lg font-extrabold tracking-wider text-plt-brown"></p>
            <p id="orderPlacedPaymentStatus" class="mt-3 text-sm font-bold"></p>
            <p id="orderPlacedPaymentNote" class="mt-2 text-sm text-stone-600"></p>
            <p id="orderPlacedPaymentCountdown" class="mt-2 text-sm font-bold text-red-700 hidden" aria-live="polite"></p>
            <p class="mt-3 text-sm">Tổng đơn hàng: <strong id="orderPlacedTotal" class="text-plt-brown"></strong></p>
            <img id="orderPlacedPaymentQr" class="mx-auto mt-4 hidden h-56 w-56 rounded-lg border border-stone-200 bg-white p-2" alt="Mã QR thanh toán MB Bank" />
            <button id="btnContinueShopping" type="button" class="mt-5 rounded-md bg-plt-brown px-6 py-3 font-brand text-sm font-extrabold uppercase text-white hover:bg-amber-900">Tiếp tục mua món</button>
          </section>
        </div>

        <aside id="checkoutSummary" class="lg:col-span-5">
          <div class="space-y-5 border border-stone-200 bg-[#f5f0e5] p-5 sm:p-6 lg:sticky lg:top-24">
            <div class="flex items-start justify-between gap-3 border-b border-stone-300 pb-3">
              <div>
                <h2 class="font-brand text-lg font-black uppercase text-plt-brown">Chi tiết đơn hàng</h2>
                <p id="checkoutItemCount" class="mt-1 text-xs text-stone-500">0 món</p>
              </div>
              <button id="btnClearCart" type="button" class="text-xs font-bold text-plt-brown underline">Xóa hết</button>
            </div>
            <div id="checkoutCartItemsList" class="max-h-[380px] space-y-3 overflow-y-auto pr-1"></div>
            <div class="space-y-2 border-t border-stone-300 pt-4 text-sm">
              <div class="flex justify-between text-stone-700"><span>Tạm tính</span><strong id="summarySubtotal">0đ</strong></div>
              <div class="flex justify-between text-stone-700"><span>Phí giao hàng</span><strong id="summaryShippingFee">0đ</strong></div>
              <div class="flex justify-between text-stone-700"><span>Giảm giá</span><strong id="summaryDiscount" class="text-emerald-700">0đ</strong></div>
              <div class="flex justify-between border-t border-stone-300 pt-3 text-base font-black text-plt-brown"><span>Tổng cộng</span><strong id="summaryGrandTotal">0đ</strong></div>
            </div>
            <div class="rounded-lg border border-stone-300 bg-white p-4">
              <label for="couponCodeInput" class="mb-2 block text-xs font-extrabold uppercase text-stone-700">Mã khuyến mãi</label>
              <div class="flex gap-2">
                <input id="couponCodeInput" type="text" maxlength="30" autocomplete="off" placeholder="Nhập mã giảm giá"
                       class="min-w-0 flex-1 rounded-md border border-stone-300 bg-white px-3 py-2.5 text-base uppercase focus:border-plt-brown focus:outline-none focus:ring-2 focus:ring-amber-300 sm:text-sm" />
                <button id="btnApplyCoupon" type="button" class="rounded-md bg-plt-brown px-4 py-2.5 text-xs font-extrabold text-white hover:bg-amber-900">Áp dụng</button>
              </div>
              <p id="couponStatus" class="mt-2 min-h-4 text-xs text-stone-500" aria-live="polite">Nhập mã rồi bấm Áp dụng.</p>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section id="view-coupon" class="hidden max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="rounded-2xl border border-stone-200 bg-white p-6 sm:p-8">
        <h1 class="font-brand text-2xl font-black uppercase text-plt-brown">Mã khuyến mãi</h1>
        <p class="mt-2 text-sm text-stone-600">Chọn sao chép mã bạn muốn tham khảo.</p>
        <div class="mt-5 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900">
          Danh sách mã khuyến mãi đang có hiệu lực. Điều kiện áp dụng được kiểm tra khi thanh toán.
        </div>
        <p id="promotionStatus" class="mt-5 text-sm text-stone-600" role="status" aria-live="polite">Đang tải khuyến mãi…</p>
        <div id="promotionCodeList" class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-live="polite"></div>
      </div>
    </section>

    <section id="view-reviews" class="hidden max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="space-y-6">
        <div>
          <h1 class="font-brand text-2xl font-black uppercase text-plt-brown">Đánh giá quán</h1>
          <p class="mt-1 text-sm text-stone-600">Cảm nhận của khách hàng về Cơm Trưa Anh Béo.</p>
        </div>

        <div class="grid gap-6 lg:grid-cols-3">
          <section class="space-y-4 rounded-2xl border border-stone-200 bg-white p-6">
            <div class="flex items-center gap-4">
              <div id="reviewAvgScore" class="font-brand text-5xl font-black text-plt-brown">0.0</div>
              <div>
                <div id="reviewAvgStars" class="text-xl tracking-wide text-amber-500" aria-hidden="true">☆☆☆☆☆</div>
                <div id="reviewTotalText" class="text-xs text-stone-500">Chưa có lượt đánh giá</div>
              </div>
            </div>
            <div id="reviewDistribution" class="space-y-1.5"></div>
          </section>

          <section class="rounded-2xl border border-stone-200 bg-white p-6 lg:col-span-2">
            <h2 class="font-extrabold text-plt-brown">Gửi đánh giá của bạn</h2>
            <div id="reviewLoginPrompt" class="mt-3 flex flex-col gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4 sm:flex-row sm:items-center">
              <p class="flex-1 text-sm text-stone-700">Vui lòng đăng nhập để gửi đánh giá về quán.</p>
              <button id="btnReviewLogin" type="button" class="rounded-xl bg-plt-brown px-4 py-2.5 text-xs font-bold uppercase text-plt-gold">
                Đăng nhập
              </button>
            </div>
            <form id="formReview" class="mt-3 hidden space-y-3" novalidate>
              <div>
                <div class="mb-1 text-xs font-bold uppercase text-stone-700">Bạn chấm quán mấy sao? *</div>
                <div class="flex items-center gap-1" role="radiogroup" aria-label="Chọn số sao">
                  <button type="button" data-star="1" class="review-star-btn text-3xl leading-none text-stone-300" role="radio" aria-checked="false" aria-label="1 sao">★</button>
                  <button type="button" data-star="2" class="review-star-btn text-3xl leading-none text-stone-300" role="radio" aria-checked="false" aria-label="2 sao">★</button>
                  <button type="button" data-star="3" class="review-star-btn text-3xl leading-none text-stone-300" role="radio" aria-checked="false" aria-label="3 sao">★</button>
                  <button type="button" data-star="4" class="review-star-btn text-3xl leading-none text-stone-300" role="radio" aria-checked="false" aria-label="4 sao">★</button>
                  <button type="button" data-star="5" class="review-star-btn text-3xl leading-none text-stone-300" role="radio" aria-checked="false" aria-label="5 sao">★</button>
                  <span id="reviewStarHint" class="ml-2 text-xs font-semibold text-stone-500"></span>
                </div>
              </div>
              <div>
                <label for="reviewComment" class="mb-1 block text-xs font-bold uppercase text-stone-700">Nhận xét (không bắt buộc)</label>
                <textarea id="reviewComment" rows="3" maxlength="500" class="w-full rounded-xl border border-stone-300 px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-plt-brown"></textarea>
                <div class="text-right text-[11px] text-stone-400"><span id="reviewCommentCount">0</span>/500</div>
              </div>
              <div id="reviewFormError" class="text-xs font-semibold text-red-600" role="alert"></div>
              <button id="btnSubmitReview" type="submit" class="rounded-xl bg-amber-500 px-5 py-2.5 text-xs font-bold uppercase text-stone-900 disabled:opacity-60">
                Gửi đánh giá
              </button>
            </form>
          </section>
        </div>

        <section class="rounded-2xl border border-stone-200 bg-white p-6">
          <h2 class="mb-4 font-extrabold text-plt-brown">Khách hàng nói gì về quán</h2>
          <div id="reviewListError" class="mb-3 hidden text-sm text-red-600" role="alert"></div>
          <div id="reviewEmptyState" class="hidden py-8 text-center text-sm text-stone-500">Chưa có đánh giá nào.</div>
          <div id="reviewList" class="divide-y divide-stone-100"></div>
          <div class="mt-4 text-center">
            <button id="btnLoadMoreReviews" type="button" class="hidden rounded-xl bg-stone-100 px-5 py-2.5 text-xs font-bold uppercase text-stone-700">
              Xem thêm đánh giá
            </button>
          </div>
        </section>
      </div>
    </section>

  </main>

  <!-- ================= MODAL 2: ĐĂNG NHẬP / ĐĂNG KÝ / QUÊN MẬT KHẨU ================= -->
  <div id="modalAuth" class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border-2 border-plt-gold space-y-5 my-8">
      <div class="flex items-center justify-between border-b border-stone-200 pb-3">
        <div>
          <div class="text-xs font-extrabold uppercase text-amber-700">TÀI KHOẢN CƠM TRƯA ANH BÉO</div>
          <h3 id="authModalTitle" class="font-brand font-black text-xl text-plt-brown uppercase">
            ĐĂNG NHẬP HỆ THỐNG
          </h3>
        </div>
        <button id="btnCloseAuthModal" type="button" class="text-stone-400 hover:text-stone-700 text-xl font-bold">✕</button>
      </div>

      <!-- Chuyển tab Đăng nhập / Đăng ký / Quên mật khẩu -->
      <div id="authTabs" class="grid grid-cols-3 gap-1.5 bg-stone-100 p-1.5 rounded-xl text-xs font-extrabold">
        <button type="button" data-authtab="login" class="auth-tab-btn py-2 rounded-lg bg-plt-brown text-plt-gold">Đăng nhập</button>
        <button type="button" data-authtab="register" class="auth-tab-btn py-2 rounded-lg text-stone-600 hover:bg-stone-200">Đăng ký</button>
        <button type="button" data-authtab="forgot" class="auth-tab-btn py-2 rounded-lg text-stone-600 hover:bg-stone-200">Quên mật khẩu</button>
      </div>

      <!-- Khung trạng thái đang đăng nhập (nếu đã đăng nhập) -->
      <div id="loggedInProfileBox" class="hidden bg-amber-50 rounded-xl p-4 border border-amber-200 space-y-3 text-sm">
        <div class="font-extrabold text-plt-brown text-base flex items-center gap-2">
          <span>👋 Xin chào,</span>
          <span id="profileNameDisplay">--</span>
        </div>
        <div class="text-xs text-stone-600 space-y-1">
          <div>📧 Email: <strong id="profileEmailDisplay">--</strong></div>
          <div>📞 SĐT: <strong id="profilePhoneDisplay">--</strong></div>
          <div>📍 Địa chỉ: <strong id="profileAddressDisplay">--</strong></div>
          <div>🔑 Vai trò: <strong id="profileRoleDisplay">--</strong></div>
        </div>
        <button id="btnEditProfile" type="button" class="w-full rounded-xl bg-plt-brown py-2.5 text-xs font-bold uppercase text-plt-gold">
          Chỉnh sửa thông tin
        </button>
        <form id="formEditProfile" class="hidden space-y-3 rounded-xl border border-amber-200 bg-white p-3" novalidate>
          <label class="block text-xs font-bold uppercase text-stone-700" for="editProfileName">Họ và tên
            <input id="editProfileName" name="FullName" type="text" required maxlength="100" autocomplete="name" class="mt-1 w-full rounded-xl border border-stone-300 px-3.5 py-2.5 text-sm">
          </label>
          <label class="block text-xs font-bold uppercase text-stone-700" for="editProfilePhone">Số điện thoại
            <input id="editProfilePhone" name="Phone" type="tel" required maxlength="10" inputmode="numeric" autocomplete="tel" placeholder="0xxxxxxxxx" class="mt-1 w-full rounded-xl border border-stone-300 px-3.5 py-2.5 text-sm">
          </label>
          <label class="block text-xs font-bold uppercase text-stone-700" for="editProfileAddress">Địa chỉ nhận hàng
            <input id="editProfileAddress" name="Address" type="text" required maxlength="255" autocomplete="street-address" class="mt-1 w-full rounded-xl border border-stone-300 px-3.5 py-2.5 text-sm">
          </label>
          <p class="text-[11px] text-stone-500">Email đăng nhập không thể thay đổi.</p>
          <div id="editProfileError" class="text-xs font-semibold text-red-600" role="alert"></div>
          <div class="grid grid-cols-2 gap-2">
            <button id="btnCancelEditProfile" type="button" class="rounded-xl bg-stone-200 py-2.5 text-xs font-bold uppercase text-stone-700">Hủy</button>
            <button id="btnSaveProfile" type="submit" class="rounded-xl bg-amber-500 py-2.5 text-xs font-bold uppercase text-stone-900">Lưu thay đổi</button>
          </div>
        </form>
        <button id="btnChangePassword" type="button" class="w-full rounded-xl bg-stone-700 py-2.5 text-xs font-bold uppercase text-white">
          Đổi mật khẩu
        </button>
        <form id="cpForm" class="hidden space-y-3 rounded-xl border border-amber-200 bg-white p-3" novalidate>
          <div id="cpStep1" class="space-y-3">
            <p class="text-xs text-stone-700">Mã xác nhận sẽ được gửi tới <strong id="cpEmailDisplay">--</strong>.</p>
            <div class="grid grid-cols-2 gap-2">
              <button id="cpCancelBtn" type="button" class="rounded-xl bg-stone-200 py-2.5 text-xs font-bold uppercase text-stone-700">Hủy</button>
              <button id="cpSendBtn" type="submit" class="rounded-xl bg-amber-500 py-2.5 text-xs font-bold uppercase text-stone-900">Gửi mã</button>
            </div>
          </div>
          <div id="cpStep2" class="hidden space-y-3">
            <div id="cpNotice" class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs text-stone-700"></div>
            <label class="block text-xs font-bold uppercase text-stone-700" for="cpCode">Mã xác nhận
              <input id="cpCode" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" class="mt-1 w-full rounded-xl border border-stone-300 px-3 py-2.5 text-center text-lg tracking-[0.4em]">
            </label>
            <label class="block text-xs font-bold uppercase text-stone-700" for="cpNewPassword">Mật khẩu mới
              <input id="cpNewPassword" type="password" autocomplete="new-password" maxlength="100" class="mt-1 w-full rounded-xl border border-stone-300 px-3.5 py-2.5 text-sm">
            </label>
            <label class="block text-xs font-bold uppercase text-stone-700" for="cpConfirmPassword">Nhập lại mật khẩu mới
              <input id="cpConfirmPassword" type="password" autocomplete="new-password" maxlength="100" class="mt-1 w-full rounded-xl border border-stone-300 px-3.5 py-2.5 text-sm">
            </label>
            <div class="flex items-center justify-between text-xs">
              <button id="cpBackBtn" type="button" class="font-bold text-stone-500">&larr; Quay lại</button>
              <button id="cpResendBtn" type="button" disabled class="font-bold text-stone-400"><span id="cpResendLabel">Gửi lại sau 1:00</span></button>
            </div>
            <button id="cpSubmitBtn" type="submit" class="w-full rounded-xl bg-plt-brown py-3 text-sm font-extrabold uppercase text-plt-gold">Đổi mật khẩu</button>
          </div>
          <div id="cpError" class="text-xs font-semibold text-red-600" role="alert"></div>
        </form>
        <a id="btnGoToAdminPanel" href="/admin" class="hidden w-full py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-stone-900 font-bold text-xs uppercase transition text-center block">
          ⚙️ Quay lại trang Quản trị Admin
        </a>
        <button id="btnLogoutAccount" type="button"
                class="w-full py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white font-bold text-xs uppercase transition">
          🚪 Đăng xuất tài khoản
        </button>
      </div>

      <!-- TAB 1: FORM ĐĂNG NHẬP -->
      <form id="formLogin" class="space-y-4">
        @Html.AntiForgeryToken()
        <div>
          <label for="loginEmailOrPhone" class="block text-xs font-bold uppercase text-stone-700 mb-1">Email hoặc Số điện thoại *</label>
          <input id="loginEmailOrPhone" name="Identifier" type="text" required autocomplete="username" maxlength="150"
                 placeholder="Nhập email hoặc số điện thoại..."
                 class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 text-sm focus:outline-none focus:ring-2 focus:ring-plt-brown" />
        </div>
        <div>
          <label for="loginPassword" class="block text-xs font-bold uppercase text-stone-700 mb-1">Mật khẩu *</label>
          <input id="loginPassword" name="Password" type="password" required autocomplete="current-password" maxlength="100"
                 placeholder="Nhập mật khẩu..."
                 class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 text-sm focus:outline-none focus:ring-2 focus:ring-plt-brown" />
        </div>
        <div class="flex items-center justify-between text-xs">
          <span class="text-stone-500">Dùng email hoặc số điện thoại và mật khẩu tài khoản</span>
          <button id="btnJumpForgotFromLogin" type="button" class="text-red-700 font-bold hover:underline">Quên mật khẩu?</button>
        </div>
        <button type="submit" class="w-full py-3 rounded-xl bg-plt-brown hover:bg-amber-900 text-plt-gold font-brand font-extrabold text-sm uppercase shadow transition">
          🔓 Đăng nhập ngay
        </button>
      </form>

      <!-- TAB 2: FORM ĐĂNG KÝ -->
      <form id="formRegister" class="hidden space-y-3.5">
        @Html.AntiForgeryToken()
        <div>
          <label for="regName" class="block text-xs font-bold uppercase text-stone-700 mb-1">Họ và tên *</label>
          <input id="regName" name="FullName" type="text" required autocomplete="name" maxlength="100" placeholder="VD: Phạm Gia Huy"
                 class="w-full px-3.5 py-2 rounded-xl border border-stone-300 text-sm focus:outline-none focus:ring-2 focus:ring-plt-brown" />
        </div>
        <div>
          <label for="regPhone" class="block text-xs font-bold uppercase text-stone-700 mb-1">Số điện thoại *</label>
          <input id="regPhone" name="Phone" type="tel" required autocomplete="tel" inputmode="numeric" maxlength="10" placeholder="VD: 0938112233"
                 class="w-full px-3.5 py-2 rounded-xl border border-stone-300 text-sm focus:outline-none focus:ring-2 focus:ring-plt-brown" />
        </div>
        <div>
          <label for="regAddress" class="block text-xs font-bold uppercase text-stone-700 mb-1">Địa chỉ nhận hàng *</label>
          <input id="regAddress" name="Address" type="text" required autocomplete="street-address" maxlength="255" placeholder="Nhập địa chỉ nhận hàng"
                 class="w-full px-3.5 py-2 rounded-xl border border-stone-300 text-sm focus:outline-none focus:ring-2 focus:ring-plt-brown" />
        </div>
        <div>
          <label for="regEmail" class="block text-xs font-bold uppercase text-stone-700 mb-1">Email *</label>
          <input id="regEmail" name="Email" type="email" required autocomplete="email" maxlength="150" placeholder="VD: giahuy@gmail.com"
                 class="w-full px-3.5 py-2 rounded-xl border border-stone-300 text-sm focus:outline-none focus:ring-2 focus:ring-plt-brown" />
        </div>
        <div>
          <label for="regPass" class="block text-xs font-bold uppercase text-stone-700 mb-1">Mật khẩu *</label>
          <input id="regPass" name="Password" type="password" required autocomplete="new-password" minlength="8" maxlength="100" placeholder="Tối thiểu 8 ký tự"
                 class="w-full px-3.5 py-2 rounded-xl border border-stone-300 text-sm focus:outline-none focus:ring-2 focus:ring-plt-brown" />
        </div>
        <button id="btnRequestRegistrationCode" type="submit" aria-busy="false" class="w-full py-3 rounded-xl bg-plt-gold hover:bg-amber-400 text-amber-950 font-brand font-extrabold text-sm uppercase shadow transition">
          <span class="inline-flex items-center gap-2">
            <span id="registrationCodeButtonIcon" aria-hidden="true">✉️</span>
            <svg id="registrationCodeButtonSpinner" class="hidden h-4 w-4 animate-spin motion-reduce:animate-none" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            <span>Gửi mã xác nhận qua email</span>
          </span>
        </button>
        <div id="registrationVerification" class="hidden space-y-3">
          <p id="registrationCodeNotice" class="text-sm text-stone-600" aria-live="polite"></p>
          <fieldset>
            <legend class="mb-2 text-xs font-bold uppercase text-stone-700">Mã xác nhận gồm 6 số *</legend>
            <div class="grid grid-cols-6 gap-2">
              <input data-registration-otp inputmode="numeric" autocomplete="one-time-code" maxlength="6" aria-label="Số thứ 1 trên 6"
                     class="aspect-square min-w-0 w-full rounded-xl border border-stone-400 bg-white text-center text-xl font-bold tabular-nums focus:outline-none focus:ring-2 focus:ring-plt-brown" />
              <input data-registration-otp inputmode="numeric" maxlength="1" aria-label="Số thứ 2 trên 6"
                     class="aspect-square min-w-0 w-full rounded-xl border border-stone-400 bg-white text-center text-xl font-bold tabular-nums focus:outline-none focus:ring-2 focus:ring-plt-brown" />
              <input data-registration-otp inputmode="numeric" maxlength="1" aria-label="Số thứ 3 trên 6"
                     class="aspect-square min-w-0 w-full rounded-xl border border-stone-400 bg-white text-center text-xl font-bold tabular-nums focus:outline-none focus:ring-2 focus:ring-plt-brown" />
              <input data-registration-otp inputmode="numeric" maxlength="1" aria-label="Số thứ 4 trên 6"
                     class="aspect-square min-w-0 w-full rounded-xl border border-stone-400 bg-white text-center text-xl font-bold tabular-nums focus:outline-none focus:ring-2 focus:ring-plt-brown" />
              <input data-registration-otp inputmode="numeric" maxlength="1" aria-label="Số thứ 5 trên 6"
                     class="aspect-square min-w-0 w-full rounded-xl border border-stone-400 bg-white text-center text-xl font-bold tabular-nums focus:outline-none focus:ring-2 focus:ring-plt-brown" />
              <input data-registration-otp inputmode="numeric" maxlength="1" aria-label="Số thứ 6 trên 6"
                     class="aspect-square min-w-0 w-full rounded-xl border border-stone-400 bg-white text-center text-xl font-bold tabular-nums focus:outline-none focus:ring-2 focus:ring-plt-brown" />
            </div>
            <p id="registrationCodeError" class="mt-2 min-h-4 text-xs text-red-600" aria-live="polite"></p>
          </fieldset>
          <div class="flex items-center justify-between text-xs text-stone-500" role="status">
            <span id="registrationResendHint">Chưa nhận được mã?</span>
            <button id="btnResendRegistrationCode" type="button" disabled class="inline-flex items-center gap-1 font-bold text-stone-400 disabled:cursor-not-allowed">
              <svg id="registrationResendSpinner" class="hidden h-3.5 w-3.5 animate-spin motion-reduce:animate-none" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4z"></path>
              </svg>
              <span id="registrationResendLabel">Gửi lại sau 1:00</span>
            </button>
          </div>
          <button id="btnVerifyRegistrationCode" type="button" class="w-full py-3 rounded-xl bg-plt-brown hover:bg-amber-900 text-plt-gold font-brand font-extrabold text-sm uppercase transition">
            Xác nhận email &amp; tạo tài khoản
          </button>
          <button id="btnEditRegistration" type="button" class="w-full text-xs font-bold text-stone-600 hover:underline">
            Đổi thông tin đăng ký
          </button>
        </div>
      </form>

      <!-- TAB 3: QUÊN MẬT KHẨU -->
      <div id="formForgotBox" class="hidden space-y-4">
        <form id="fpForm" class="space-y-3" novalidate>
          <div id="fpStep1" class="space-y-3">
            <p class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs text-stone-700">Nhập email đã đăng ký để nhận mã đặt lại mật khẩu.</p>
            <label class="block text-xs font-bold uppercase text-stone-700" for="fpEmail">Email đã đăng ký
              <input id="fpEmail" type="email" autocomplete="email" maxlength="150" class="mt-1 w-full rounded-xl border border-stone-300 px-3.5 py-2.5 text-sm">
            </label>
            <button id="fpSendBtn" type="submit" class="w-full rounded-xl bg-amber-500 py-3 text-sm font-extrabold uppercase text-stone-900">Gửi mã xác nhận</button>
          </div>
          <div id="fpStep2" class="hidden space-y-3">
            <div id="fpNotice" class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-xs text-stone-700"></div>
            <label class="block text-xs font-bold uppercase text-stone-700" for="fpCode">Mã xác nhận
              <input id="fpCode" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" class="mt-1 w-full rounded-xl border border-stone-300 px-3 py-2.5 text-center text-lg tracking-[0.4em]">
            </label>
            <label class="block text-xs font-bold uppercase text-stone-700" for="fpNewPassword">Mật khẩu mới
              <input id="fpNewPassword" type="password" autocomplete="new-password" maxlength="100" class="mt-1 w-full rounded-xl border border-stone-300 px-3.5 py-2.5 text-sm">
            </label>
            <label class="block text-xs font-bold uppercase text-stone-700" for="fpConfirmPassword">Nhập lại mật khẩu mới
              <input id="fpConfirmPassword" type="password" autocomplete="new-password" maxlength="100" class="mt-1 w-full rounded-xl border border-stone-300 px-3.5 py-2.5 text-sm">
            </label>
            <div class="flex items-center justify-between text-xs">
              <button id="fpBackBtn" type="button" class="font-bold text-stone-500">&larr; Quay lại</button>
              <button id="fpResendBtn" type="button" disabled class="font-bold text-stone-400"><span id="fpResendLabel">Gửi lại sau 1:00</span></button>
            </div>
            <button id="fpSubmitBtn" type="submit" class="w-full rounded-xl bg-plt-brown py-3 text-sm font-extrabold uppercase text-plt-gold">Đặt lại mật khẩu</button>
          </div>
          <div id="fpError" class="text-xs font-semibold text-red-600" role="alert"></div>
        </form>
        <button id="btnBackLoginFromForgot" type="button"
                class="w-full py-3 rounded-xl bg-plt-brown hover:bg-amber-900 text-plt-gold font-brand font-extrabold text-sm uppercase transition">
          Quay lại đăng nhập
        </button>
      </div>
    </div>
  </div>

