@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CƠM TRƯA ANH BÉO - Cùng Anh Béo thưởng thức cơm trưa nóng hổi mỗi ngày</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/index.css" asp-append-version="true" />
</head>
<body class="min-h-screen flex flex-col justify-between">

  <!-- ================= HEADER (PHONG CÁCH PHÚC LỘC THỌ) ================= -->
  <header class="bg-plt-brown text-white sticky top-0 z-40 shadow-lg border-b border-amber-900/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-1 sm:gap-3">
      <!-- Brand Logo -->
      <button id="btnLogoHome" type="button" class="min-w-0 text-left group focus:outline-none flex items-center gap-2 sm:gap-3">
        <div class="w-10 h-10 sm:w-12 sm:h-12 shrink-0 rounded-xl bg-amber-500/20 border-2 border-plt-gold flex items-center justify-center shadow-inner">
          <span class="text-2xl" role="img" aria-label="rice">🍚</span>
        </div>
        <div class="min-w-0 max-w-[125px] sm:max-w-none">
          <div class="hidden sm:block text-plt-gold font-brand font-extrabold text-xs sm:text-sm tracking-wider uppercase leading-tight group-hover:text-amber-300 transition">
            ComTruaAnhBeo.vn
          </div>
          <div class="text-white font-brand font-black text-base sm:text-2xl tracking-tight uppercase leading-tight sm:leading-none mt-0.5">
            CƠM TRƯA ANH BÉO
          </div>
        </div>
      </button>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-6 text-xs xl:text-sm font-bold tracking-wide uppercase">
        <button type="button" data-nav="home" class="nav-tab-btn text-plt-gold hover:text-amber-300 transition py-2 border-b-2 border-plt-gold">
          VỀ ANH BÉO
        </button>
        <button type="button" data-nav="menu" class="nav-tab-btn text-white hover:text-plt-gold transition py-2 border-b-2 border-transparent">
          THỰC ĐƠN
        </button>
        <button type="button" data-nav="coupon" class="nav-tab-btn text-white hover:text-plt-gold transition py-2 border-b-2 border-transparent">
          MÃ KHUYẾN MÃI
        </button>
        <button type="button" data-nav="reviews" class="nav-tab-btn text-white hover:text-plt-gold transition py-2 border-b-2 border-transparent">
          ĐÁNH GIÁ QUÁN
        </button>
      </nav>

      <!-- Right Action Icons: User Auth, Shopping Cart (Click jumps to Menu) -->
      <div class="shrink-0 flex items-center gap-1.5 sm:gap-3">
        <!-- Auth Button (Đăng nhập / Đăng xuất) -->
        <button id="btnHeaderAuth" type="button"
                aria-label="Đăng nhập" class="shrink-0 px-2 sm:px-3 py-2 rounded-full border-2 border-plt-gold/80 text-xs sm:text-sm font-bold text-plt-gold hover:bg-plt-gold hover:text-amber-950 transition flex items-center gap-1.5">
          <span>👤</span>
          <span id="headerAuthLabel" class="hidden sm:inline">Đăng nhập</span>
        </button>

        <!-- Cart Button: Khi bấm vào trỏ tới menu của quán + mở thanh giỏ hàng nhanh -->
        <button id="btnHeaderCart" type="button"
                title="Bấm vào để xem Thực đơn của quán và Giỏ hàng"
                class="relative w-11 h-11 shrink-0 rounded-full bg-amber-950/80 border-2 border-plt-gold flex items-center justify-center text-plt-gold hover:bg-plt-gold hover:text-amber-950 transition pulse-gold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2 29m12-29l2 29m-6-23a1 1 0 11-2 0 1 1 0 012 0zm8 0a1 1 0 11-2 0 1 1 0 012 0z" />
            <circle cx="9" cy="19" r="1.7" fill="currentColor"/>
            <circle cx="17" cy="19" r="1.7" fill="currentColor"/>
          </svg>
          <span id="cartCountBadge" class="absolute -top-1.5 -right-1.5 bg-red-600 text-white text-[11px] font-extrabold w-5 h-5 rounded-full flex items-center justify-center border border-white shadow">
            0
          </span>
        </button>

        <!-- Mobile Menu Toggle -->
        <button id="btnMobileMenu" type="button" class="lg:hidden shrink-0 p-2 rounded-lg text-plt-gold border border-plt-gold/50 hover:bg-amber-900/40">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Bar -->
    <div id="mobileNavMenu" class="hidden lg:hidden bg-plt-brown-dark border-t border-amber-900/60 px-4 py-3 space-y-2">
      <div class="grid grid-cols-2 gap-2 text-xs font-bold uppercase">
        <button type="button" data-nav="home" class="nav-tab-btn text-left px-3 py-2.5 rounded-lg bg-amber-900/40 text-plt-gold">🏠 Về Anh Béo</button>
        <button type="button" data-nav="menu" class="nav-tab-btn text-left px-3 py-2.5 rounded-lg bg-amber-900/20 text-white">🍱 Thực đơn</button>
        <button type="button" data-nav="coupon" class="nav-tab-btn text-left px-3 py-2.5 rounded-lg bg-amber-900/20 text-white">🎟️ Mã khuyến mãi</button>
        <button type="button" data-nav="reviews" class="nav-tab-btn text-left px-3 py-2.5 rounded-lg bg-amber-900/20 text-white">⭐ Đánh giá quán</button>
      </div>
    </div>
  </header>

  <!-- ================= MAIN CONTENT CONTAINER ================= -->
  <main class="flex-grow">

    <!-- ================= VIEW 1: TRANG CHỦ & THỰC ĐƠN (GIỐNG CƠM TẤM PHÚC LỘC THỌ) ================= -->
    <section id="view-home" class="space-y-10 pb-12">

      <!-- HERO BANNER (MÂM CƠM TẤM SƯỜN BÌ CHẢ HEO QUAY TRÊN Mẹt TRE LÁ CHUỐI) -->
      <div class="relative w-full h-[380px] sm:h-[470px] lg:h-[540px] overflow-hidden bg-stone-900">
        <img src="/images/hero.jpg"
             alt="Mâm Cơm Trưa Anh Béo"
             class="w-full h-full object-cover object-center opacity-90 scale-105 transition duration-700" />
        <div class="absolute inset-0 bg-gradient-to-r from-[#330D0A]/90 via-[#4A1511]/65 to-transparent flex items-center">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
            <div class="max-w-2xl space-y-4">
              <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-plt-gold text-amber-950 font-extrabold text-xs sm:text-sm uppercase tracking-wider shadow">
                <span>🔥</span> Cửa hàng duy nhất tại 450 Lê Văn Việt, TP.HCM
              </div>
              <h1 class="font-brand font-black text-3xl sm:text-5xl lg:text-6xl text-white uppercase tracking-tight leading-none drop-shadow-md">
                CƠM TRƯA <span class="text-plt-gold">ANH BÉO</span>
              </h1>
              <p class="text-amber-50 text-base sm:text-xl font-medium leading-relaxed drop-shadow">
                “Cùng Anh Béo thưởng thức cơm trưa nóng hổi mỗi ngày. Ghé ngay Cơm trưa Anh Béo để trải nghiệm.”
              </p>
              <div class="pt-2 flex flex-wrap items-center gap-3">
                <button id="btnHeroWatchMenu" type="button"
                        class="px-6 py-3.5 rounded-xl bg-plt-gold hover:bg-amber-400 text-amber-950 font-brand font-black text-sm sm:text-base uppercase tracking-wide shadow-lg transition transform hover:-translate-y-0.5 flex items-center gap-2">
                  <span>🍽️</span> XEM MENU &amp; ĐẶT MÓN NGAY
                </button>
                <a href="https://www.tiktok.com/@@2hoanghieu7258" target="_blank" rel="noopener noreferrer"
                   class="px-5 py-3.5 rounded-xl bg-white/15 hover:bg-white/25 backdrop-blur-sm text-white border border-white/40 font-bold text-sm sm:text-base transition flex items-center gap-2">
                  <svg class="w-5 h-5 fill-current text-plt-gold" viewBox="0 0 24 24">
                    <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
                  </svg>
                  <span>TikTok @@hoanghieu7258</span>
                </a>
              </div>
              <div class="pt-2 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs sm:text-sm text-amber-200 font-semibold">
                <span>📍 450 Lê Văn Việt, P. Tăng Nhơn Phú, TP.HCM</span>
                <span>📞 0775058143 – Mr. Khoa (Zalo: 0775058143)</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ================= KHU VỰC MENU QUÁN (44 MÓN ĐẦY ĐỦ) ================= -->
      <div id="menuSectionAnchor" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-2 space-y-6">
        <!-- Tiêu đề Menu & Thanh tìm kiếm / Lọc danh mục -->
        <div class="bg-plt-brown text-white rounded-2xl p-6 sm:p-8 shadow-lg flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">
          <div class="space-y-1.5">
            <div class="inline-flex items-center gap-2 text-plt-gold text-xs font-extrabold uppercase tracking-widest">
              <span>🍚</span> THỰC ĐƠN CHÍNH THỨC • CƠM TRƯA ANH BÉO
            </div>
            <h2 class="font-brand font-black text-2xl sm:text-3xl uppercase">
              MENU 44 MÓN NÓNG HỔI MỖI NGÀY
            </h2>
            <p class="text-amber-100/90 text-xs sm:text-sm">
              Bấm <strong class="text-plt-gold">“Đặt hàng ngay”</strong> trên bất kỳ món nào để chuyển thẳng tới giao diện Đặt hàng, hoặc bấm <strong class="text-plt-gold">“+ Thêm vào giỏ”</strong> để chọn nhiều món cùng lúc.
            </p>
          </div>

          <!-- Ô tìm kiếm món ăn -->
          <div class="w-full lg:w-80">
            <div class="relative">
              <input id="inputSearchMenu" type="text"
                     placeholder="Tìm món: sườn bì chả, heo quay, canh..."
                     class="w-full pl-10 pr-4 py-3 rounded-xl bg-white text-stone-900 placeholder-stone-400 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-plt-gold shadow-inner" />
              <span class="absolute left-3.5 top-3 text-stone-400">🔍</span>
            </div>
          </div>
        </div>

        <!-- Bộ lọc Danh mục + Tóm tắt Giỏ hàng nhanh -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-4 rounded-2xl shadow-sm border border-stone-200 sticky top-20 z-30">
          <div class="flex flex-wrap items-center gap-2" id="categoryFilterBar">
            <button type="button" data-cat="ALL" class="cat-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-extrabold bg-plt-brown text-plt-gold shadow-sm transition">
              Tất cả (44 món)
            </button>
            <button type="button" data-cat="1" class="cat-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-stone-100 text-stone-700 hover:bg-amber-100 transition">
              🍛 Cơm Trưa Đặc Sản (24)
            </button>
            <button type="button" data-cat="2" class="cat-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-stone-100 text-stone-700 hover:bg-amber-100 transition">
              🥣 Canh &amp; Rau Kho Quẹt (8)
            </button>
            <button type="button" data-cat="3" class="cat-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-stone-100 text-stone-700 hover:bg-amber-100 transition">
              🍗 Món Thêm / Topping (8)
            </button>
            <button type="button" data-cat="4" class="cat-filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-stone-100 text-stone-700 hover:bg-amber-100 transition">
              🥤 Nước Uống &amp; Khăn Lạnh (4)
            </button>
          </div>

          <div class="flex items-center justify-between md:justify-end gap-3 border-t md:border-t-0 pt-3 md:pt-0 border-stone-200">
            <div class="text-xs sm:text-sm">
              <span class="text-stone-500 font-medium">Đã chọn:</span>
              <strong id="stickyCartCount" class="text-plt-brown font-extrabold">0 món</strong>
              <span class="mx-1 text-stone-300">|</span>
              <strong id="stickyCartTotal" class="text-red-600 font-black">0đ</strong>
            </div>
            <button id="btnStickyGoCheckout" type="button"
                    class="px-4 py-2.5 rounded-xl bg-plt-gold hover:bg-amber-400 text-amber-950 font-brand font-extrabold text-xs sm:text-sm uppercase shadow transition flex items-center gap-1.5">
              <span>🛒 Tiến hành Đặt hàng</span>
              <span>→</span>
            </button>
          </div>
        </div>

        <!-- Lưới hiển thị 44 món ăn -->
        <div id="menuGridContainer" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
          <!-- Render tự động bằng JS từ dữ liệu SQL Server MonAn -->
        </div>
      </div>
    </section>

    <!-- ================= VIEW 2: GIAO DIỆN ĐẶT HÀNG & THANH TOÁN (THEO ĐÚNG QUY TRÌNH) ================= -->
    <section id="view-checkout" class="hidden max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
      <!-- Thanh điều hướng bước Đặt hàng -> Thanh toán -> Hoàn tất -->
      <div class="bg-white rounded-2xl p-5 shadow-sm border border-stone-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <button id="btnBackToMenuFromCheckout" type="button" class="text-xs sm:text-sm font-bold text-plt-brown hover:underline flex items-center gap-1">
            <span>← Quay lại Thực đơn chọn thêm món</span>
          </button>
          <h2 class="font-brand font-black text-xl sm:text-2xl text-plt-brown uppercase mt-1">
            QUÁ TRÌNH ĐẶT HÀNG &amp; TÍNH PHÍ SHIP TỰ ĐỘNG
          </h2>
        </div>
        <div class="flex items-center gap-2 text-xs font-extrabold uppercase">
          <span id="stepBadge1" class="px-3 py-1.5 rounded-full bg-plt-brown text-plt-gold">1. Thông tin &amp; Giỏ hàng</span>
          <span class="text-stone-400">→</span>
          <span id="stepBadge2" class="px-3 py-1.5 rounded-full bg-stone-200 text-stone-600">2. Tính Ship &amp; Thanh toán</span>
          <span class="text-stone-400">→</span>
          <span id="stepBadge3" class="px-3 py-1.5 rounded-full bg-stone-200 text-stone-600">3. Gửi Email Xác Nhận</span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- CỘT TRÁI (7 CỘT): THÔNG TIN KHÁCH HÀNG + GOOGLE MAPS API TÍNH SHIP -->
        <div class="lg:col-span-7 space-y-6">

          <!-- BƯỚC 1: FORM THÔNG TIN ĐẶT HÀNG (HỌ TÊN, SĐT, ĐỊA CHỈ, EMAIL) -->
          <div class="bg-white rounded-2xl p-6 shadow-md border border-stone-200 space-y-5">
            <div class="flex items-center justify-between border-b border-stone-200 pb-3">
              <div class="flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-lg bg-plt-brown text-plt-gold font-brand font-black flex items-center justify-center text-sm">1</span>
                <h3 class="font-brand font-extrabold text-lg text-plt-brown uppercase">
                  THÔNG TIN KHÁCH ĐẶT HÀNG
                </h3>
              </div>
              <span class="text-xs text-stone-500 font-medium">* Bắt buộc nhập đầy đủ</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="orderFullName" class="block text-xs font-bold uppercase text-stone-700 mb-1">
                  Họ và tên khách hàng *
                </label>
                <input id="orderFullName" type="text" required
                       placeholder="VD: Nguyễn Minh Tuấn"
                       class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-plt-brown" />
              </div>
              <div>
                <label for="orderPhone" class="block text-xs font-bold uppercase text-stone-700 mb-1">
                  Số điện thoại nhận hàng *
                </label>
                <input id="orderPhone" type="tel" required
                       placeholder="VD: 0909123456"
                       class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-plt-brown" />
              </div>
            </div>

            <div>
              <label for="orderEmail" class="block text-xs font-bold uppercase text-stone-700 mb-1">
                Địa chỉ Email (Để nhận thông báo xác nhận đơn hàng) *
              </label>
              <input id="orderEmail" type="email" required
                     placeholder="VD: khachhang@gmail.com"
                     class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-plt-brown" />
            </div>

            <!-- KHU VỰC ĐỊA CHỈ & TÍNH PHÍ SHIP GOOGLE MAPS TỪ 450 LÊ VĂN VIỆT -->
            <div class="bg-amber-50/70 rounded-2xl p-4 sm:p-5 border border-amber-200 space-y-4">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div>
                  <div class="text-xs font-extrabold uppercase text-plt-brown flex items-center gap-1.5">
                    <span>🗺️</span> ĐỊNH TUYẾN GOOGLE MAPS &amp; TÍNH PHÍ SHIP TỰ ĐỘNG
                  </div>
                  <p class="text-xs text-stone-600 mt-0.5">
                    Điểm bắt đầu cố định: <strong>450 Lê Văn Việt, Phường Tăng Nhơn Phú, TP.HCM</strong>
                  </p>
                </div>
                <span class="px-2.5 py-1 rounded-full bg-red-100 text-red-800 font-bold text-[11px] w-fit">
                  ⚠️ Chỉ ship nội thành TP.HCM
                </span>
              </div>

              <!-- Chọn nhanh khu vực / Quận Huyện để hỗ trợ định vị hoặc kiểm tra ngoại tỉnh -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label for="orderProvinceSelect" class="block text-xs font-bold text-stone-700 mb-1">
                    Tỉnh / Thành phố giao đến *
                  </label>
                  <select id="orderProvinceSelect"
                          class="w-full px-3 py-2.5 rounded-xl border border-stone-300 bg-white text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-plt-brown">
                    <option value="HCM" selected>Thành phố Hồ Chí Minh (Nội thành)</option>
                    <option value="BINH_DUONG">Tỉnh Bình Dương (Ngoại tỉnh - Không giao)</option>
                    <option value="DONG_NAI">Tỉnh Đồng Nai (Ngoại tỉnh - Không giao)</option>
                    <option value="LONG_AN">Tỉnh Long An (Ngoại tỉnh - Không giao)</option>
                    <option value="VUNG_TAU">Bà Rịa - Vũng Tàu (Ngoại tỉnh - Không giao)</option>
                    <option value="HA_NOI">Thành phố Hà Nội (Ngoại tỉnh - Không giao)</option>
                  </select>
                </div>

                <div>
                  <label for="orderQuickLandmark" class="block text-xs font-bold text-stone-700 mb-1">
                    Gợi ý tuyến đường thực tế từ 450 Lê Văn Việt
                  </label>
                  <select id="orderQuickLandmark"
                          class="w-full px-3 py-2.5 rounded-xl border border-stone-300 bg-white text-sm font-medium focus:outline-none focus:ring-2 focus:ring-plt-brown">
                    <option value="">-- Hoặc tự nhập địa chỉ bên dưới --</option>
                    <option value="380 Lê Văn Việt, Phường Tăng Nhơn Phú, TP.HCM|0.8">380 Lê Văn Việt, P. Tăng Nhơn Phú (~0.8 km)</option>
                    <option value="120 Man Thiện, Phường Tăng Nhơn Phú A, TP. Thủ Đức, TP.HCM|1.5">120 Man Thiện, P. Tăng Nhơn Phú A (~1.5 km)</option>
                    <option value="50 Võ Văn Ngân, Phường Bình Thọ, TP. Thủ Đức, TP.HCM|3.2">50 Võ Văn Ngân, P. Bình Thọ, Thủ Đức (~3.2 km)</option>
                    <option value="215 Đỗ Xuân Hợp, Phường Phước Long B, TP. Thủ Đức, TP.HCM|4.5">215 Đỗ Xuân Hợp, P. Phước Long B (~4.5 km)</option>
                    <option value="Khu Công Nghệ Cao Quận 9, Xa Lộ Hà Nội, TP.HCM|2.8">Khu Công Nghệ Cao Q.9, TP.HCM (~2.8 km)</option>
                    <option value="720A Điện Biên Phủ, Vinhomes Central Park, Bình Thạnh, TP.HCM|11.5">Vinhomes Central Park, Q. Bình Thạnh (~11.5 km)</option>
